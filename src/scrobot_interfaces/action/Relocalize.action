# Goal
# -1 selects any valid court tag; current explicit IDs are 0..3.
int32 preferred_tag_id
# Number of stationary localization samples to collect; <= 0 uses the server default.
int32 sample_count
# Overall action timeout in seconds; <= 0 uses the server default.
float32 timeout_sec
---
# Result
bool success
int32[] used_tag_ids
# Committed map -> odom transform: x/y in metres, yaw in radians.
float64 map_to_odom_x
float64 map_to_odom_y
float64 map_to_odom_yaw
# Correction applied to the previous map -> odom state: x/y in metres, yaw in radians.
float64 delta_x
float64 delta_y
float64 delta_yaw
# Batch spread/uncertainty summary: x/y in metres, yaw in radians.
float64 std_x
float64 std_y
float64 std_yaw
string message
---
# Feedback
int32 samples_collected
bool stationary
int32[] visible_tag_ids
# Best currently accepted tag distance in metres; -1 means unavailable.
float32 best_tag_distance
# AprilTag detector decision margin; -1 means unavailable.
float32 best_decision_margin
