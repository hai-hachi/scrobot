    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Status1
      Splitter Ratio: 0.5
    Tree Height: 325
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
