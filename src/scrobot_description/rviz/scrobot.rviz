        - /Global Options1
        - /Status1
        - /PointCloud21
        - /PointCloud21/Topic1
        - /Image1
        - /Image1/Status1
        - /Image1/Topic1
      Splitter Ratio: 0.5
    Tree Height: 571
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
