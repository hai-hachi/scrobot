Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Alpha: 0.45
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>

    - Class: rviz_default_plugins/RobotModel
      Name: Robot
      Enabled: true
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.35
      Show Arrows: true
      Show Axes: true
      Show Names: false

    - Class: rviz_default_plugins/MarkerArray
      Name: Court
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /court_markers

    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Enabled: true
      Alpha: 0.35
      Color Scheme: costmap
      Draw Behind: true
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /global_costmap/costmap

    - Class: rviz_default_plugins/Map
      Name: Local Costmap
      Enabled: true
      Alpha: 0.55
      Color Scheme: costmap
      Draw Behind: false
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_costmap/costmap

    - Class: rviz_default_plugins/Path
      Name: Nav2 Global Plan
      Enabled: true
      Color: 25; 255; 25
      Line Style: Lines
      Line Width: 0.05
      Pose Style: None
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /plan

    - Class: rviz_default_plugins/Pose
      Name: Current Mission Goal
      Enabled: true
      Shape: Arrow
      Color: 255; 85; 0
      Alpha: 1
      Shaft Length: 0.35
      Shaft Radius: 0.025
      Head Length: 0.15
      Head Radius: 0.06
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /mission/current_goal

    - Class: rviz_default_plugins/PoseArray
      Name: Patrol Points
      Enabled: true
      Shape: Arrow (Flat)
      Color: 255; 165; 0
      Alpha: 0.9
      Arrow Length: 0.20
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /mission/patrol_points

    - Class: rviz_default_plugins/PoseArray
      Name: Shuttles - Gazebo Ground Truth
      Enabled: true
      Shape: Axes
      Color: 0; 255; 255
      Alpha: 1
      Axes Length: 0.16
      Axes Radius: 0.012
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /evaluation/shuttle_ground_truth

    - Class: rviz_default_plugins/Polygon
      Name: Collection Zone
      Enabled: true
      Color: 0; 255; 100
      Alpha: 1
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /mission/collection_zone

    - Class: rviz_default_plugins/Polygon
      Name: Collision Stop Zone
      Enabled: true
      Color: 255; 0; 0
      Alpha: 1
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /collision_monitor/stop_zone

    - Class: rviz_default_plugins/Polygon
      Name: Collision Slowdown Zone
      Enabled: true
      Color: 255; 220; 0
      Alpha: 1
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /collision_monitor/slowdown_zone

    - Class: rviz_default_plugins/LaserScan
      Name: Depth Scan
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/camera/depth/scan
      Style: Points
      Size (Pixels): 3
      Decay Time: 0

    - Class: rviz_default_plugins/PointCloud2
      Name: Depth PointCloud
      Enabled: false
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/camera/depth/points
      Style: Points
      Size (Pixels): 2
      Decay Time: 0

  Enabled: true
  Global Options:
    Background Color: 40; 40; 40
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Angle: 0
      Scale: 45
      Target Frame: map
      X: 0
      Y: 0
      Name: Court Top View
Window Geometry:
  Height: 1000
  Width: 1600
  X: 0
  Y: 30
