Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.78
    Tree Height: 720
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5

Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Court Grid
      Enabled: true
      Value: true
      Alpha: 0.35
      Cell Size: 1
      Color: 120; 120; 120
      Line Style:
        Line Width: 0.02
        Value: Lines
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>

    - Class: rviz_default_plugins/RobotModel
      Name: Robot
      Enabled: true
      Value: true
      Alpha: 1
      Collision Enabled: false
      Description File: ""
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
      Mass Properties:
        Inertia: false
        Mass: false
      TF Prefix: ""
      Update Interval: 0
      Visual Enabled: true

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Value: true
      Frame Timeout: 15
      Marker Scale: 0.18
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Update Interval: 0
      Filter (blacklist): ""
      Filter (whitelist): ""
      Frames:
        All Enabled: true
      Tree: {}

    - Class: rviz_default_plugins/MarkerArray
      Name: Court
      Enabled: true
      Value: true
      Namespaces: {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /court_markers

    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Enabled: true
      Value: true
      Alpha: 0.25
      Binary representation: false
      Binary threshold: 100
      Color Scheme: costmap
      Draw Behind: true
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /global_costmap/costmap
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /global_costmap/costmap_updates
      Use Timestamp: false

    - Class: rviz_default_plugins/Map
      Name: Local Costmap
      Enabled: true
      Value: true
      Alpha: 0.45
      Binary representation: false
      Binary threshold: 100
      Color Scheme: costmap
      Draw Behind: false
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_costmap/costmap
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_costmap/costmap_updates
      Use Timestamp: false

    - Class: rviz_default_plugins/Path
      Name: Mission Sweep Path
      Enabled: true
      Value: true
      Alpha: 1
      Buffer Length: 1
      Color: 0; 255; 0
      Line Style: Lines
      Line Width: 0.05
      Pose Style: None
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /mission/sweep_path

    - Class: rviz_default_plugins/Path
      Name: Nav2 Active Plan
      Enabled: true
      Value: true
      Alpha: 1
      Buffer Length: 1
      Color: 255; 255; 0
      Line Style: Lines
      Line Width: 0.035
      Pose Style: None
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /plan

    - Class: rviz_default_plugins/PoseArray
      Name: Fixed Relocalization Stops
      Enabled: true
      Value: true
      Alpha: 1
      Color: 255; 0; 255
      Shape: Arrow (Flat)
      Arrow Length: 0.30
      Shaft Length: 0.25
      Shaft Radius: 0.015
      Head Length: 0.10
      Head Radius: 0.04
      Axes Length: 0.30
      Axes Radius: 0.02
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /mission/relocalization_stops

    - Class: rviz_default_plugins/Pose
      Name: Current Mission Goal
      Enabled: true
      Value: true
      Alpha: 1
      Color: 255; 85; 0
      Shape: Arrow
      Shaft Length: 0.35
      Shaft Radius: 0.025
      Head Length: 0.15
      Head Radius: 0.06
      Axes Length: 0.40
      Axes Radius: 0.03
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /mission/current_goal

    - Class: rviz_default_plugins/PoseArray
      Name: Shuttle Ground Truth
      Enabled: true
      Value: true
      Alpha: 1
      Color: 255; 0; 0
      Shape: Axes
      Arrow Length: 0.30
      Shaft Length: 0.23
      Shaft Radius: 0.009
      Head Length: 0.07
      Head Radius: 0.03
      Axes Length: 0.16
      Axes Radius: 0.012
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /evaluation/shuttle_ground_truth

    - Class: rviz_default_plugins/Polygon
      Name: Collision Stop Zone
      Enabled: true
      Value: true
      Alpha: 1
      Color: 255; 0; 0
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /collision_monitor/stop_zone

    - Class: rviz_default_plugins/Polygon
      Name: Collision Slowdown Zone
      Enabled: true
      Value: true
      Alpha: 1
      Color: 255; 220; 0
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /collision_monitor/slowdown_zone

    - Class: rviz_default_plugins/LaserScan
      Name: Depth Obstacle Scan
      Enabled: false
      Value: false
      Alpha: 1
      Axis: Z
      Channel Name: intensity
      Color: 255; 255; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.01
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/camera/depth/scan
      Use Fixed Frame: true
      Use rainbow: false

    - Class: rviz_default_plugins/Odometry
      Name: Filtered Odometry
      Enabled: false
      Value: false
      Keep: 200
      Position Tolerance: 0.05
      Angle Tolerance: 0.10
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odometry/filtered
      Shape:
        Value: Arrow
        Alpha: 1
        Axes Length: 0.25
        Axes Radius: 0.01
        Color: 255; 0; 255
        Head Length: 0.07
        Head Radius: 0.03
        Shaft Length: 0.20
        Shaft Radius: 0.01
      Covariance:
        Value: false

    - Class: rviz_default_plugins/Path
      Name: Evaluation Ground Truth Path
      Enabled: false
      Value: false
      Alpha: 1
      Buffer Length: 1
      Color: 0; 200; 255
      Line Style: Lines
      Line Width: 0.04
      Pose Style: None
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /evaluation/ground_truth_path

    - Class: rviz_default_plugins/Path
      Name: Evaluation Estimated Path
      Enabled: false
      Value: false
      Alpha: 0.85
      Buffer Length: 1
      Color: 255; 0; 255
      Line Style: Lines
      Line Width: 0.03
      Pose Style: None
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /evaluation/estimated_path

  Enabled: true
  Global Options:
    Background Color: 40; 40; 40
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Angle: 0
      Class: rviz_default_plugins/TopDownOrtho
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Invert Z Axis: false
      Name: Top Down Court
      Near Clip Distance: 0.01
      Scale: 85
      Target Frame: map
      Value: TopDownOrtho (rviz_default_plugins)
    Saved: ~

Window Geometry:
  Displays:
    collapsed: false
  Selection:
    collapsed: true
  Views:
    collapsed: false
  Height: 900
  Width: 1500
  X: 50
  Y: 50
