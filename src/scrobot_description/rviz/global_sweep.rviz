Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 20
      Cell Size: 1
      Alpha: 0.45
      Color: 160; 160; 164
      Value: true

    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: Robot
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
      Value: true

    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Marker Scale: 0.25
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Value: true

    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Court
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /court_markers
      Value: true

    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Global Costmap
      Alpha: 0.30
      Color Scheme: costmap
      Draw Behind: true
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /global_costmap/costmap
      Value: true

    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Local Costmap
      Alpha: 0.55
      Color Scheme: costmap
      Draw Behind: false
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_costmap/costmap
      Value: true

    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Nav2 Global Plan
      Alpha: 1
      Line Style: Lines
      Line Width: 0.05
      Color: 25; 255; 25
      Pose Style: None
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /plan
      Value: true

    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Global Sweep Path
      Alpha: 1
      Line Style: Lines
      Line Width: 0.07
      Color: 0; 170; 255
      Pose Style: None
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /mission/sweep_path
      Value: true

    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Collection Route
      Alpha: 1
      Line Style: Lines
      Line Width: 0.09
      Color: 255; 80; 80
      Pose Style: None
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /mission/collection_route
      Value: true

    - Class: rviz_default_plugins/PoseArray
      Enabled: true
      Name: Recorded Shuttles
      Alpha: 1
      Color: 255; 215; 0
      Shape: Axes
      Axes Length: 0.18
      Axes Radius: 0.015
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /mission/recorded_shuttles
      Value: true

    - Class: rviz_default_plugins/PoseArray
      Enabled: true
      Name: Shuttle Ground Truth
      Alpha: 0.65
      Color: 0; 255; 255
      Shape: Axes
      Axes Length: 0.15
      Axes Radius: 0.01
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /evaluation/shuttle_ground_truth
      Value: true

    - Class: rviz_default_plugins/Pose
      Enabled: true
      Name: Current Mission Goal
      Shape: Arrow
      Color: 255; 85; 0
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /mission/current_goal
      Value: true

    - Class: rviz_default_plugins/Polygon
      Enabled: true
      Name: Collection Zone
      Color: 0; 255; 100
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /mission/collection_zone
      Value: true

  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top Down
      Angle: 0
      Scale: 45
      X: 0
      Y: 0
Window Geometry:
  Height: 900
  Width: 1500
