<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="scrobot_sensors">
    <!-- RGB-D camera mechanical frame. -->
    <link name="camera_link">
      <visual>
        <geometry>
          <box size="0.06 0.10 0.05"/>
        </geometry>
        <material name="scrobot_sensor"/>
      </visual>
    </link>

    <joint name="camera_joint" type="fixed">
      <parent link="base_link"/>
      <child link="camera_link"/>
      <!-- Placeholder mounting pose relative to base_link. -->
      <origin xyz="0.18 0 0.23" rpy="0 0 0"/>
    </joint>

    <!--
      ROS optical-frame convention:
        +Z forward through the lens
        +X right in the image
        +Y down in the image
    -->
    <link name="camera_color_optical_frame"/>
    <joint name="camera_color_optical_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_color_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi / 2.0} 0 ${-pi / 2.0}"/>
    </joint>

    <link name="camera_depth_optical_frame"/>
    <joint name="camera_depth_optical_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_depth_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi / 2.0} 0 ${-pi / 2.0}"/>
    </joint>

    <!-- IMU frame. Mounting pose is a placeholder. -->
    <link name="imu_link">
      <visual>
        <geometry>
          <box size="0.04 0.04 0.015"/>
        </geometry>
        <material name="scrobot_sensor"/>
      </visual>
    </link>

    <joint name="imu_joint" type="fixed">
      <parent link="base_link"/>
      <child link="imu_link"/>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

</robot>
