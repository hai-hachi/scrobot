<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include
    filename="$(find scrobot_description)/urdf/realsense_d435i.xacro"/>

  <!-- Robot-side sensor mounting. D435i internal geometry is defined in
       realsense_d435i.xacro. The separate HMC5883L path was removed from the
       final robot design; localization uses the D435i IMU only. -->
  <xacro:macro name="scrobot_sensors">

    <xacro:scrobot_d435i parent="base_link" name="camera">
      <origin
        xyz="${camera_x} ${camera_y} ${camera_z}"
        rpy="${camera_roll} ${camera_pitch} ${camera_yaw}"/>
    </xacro:scrobot_d435i>

  </xacro:macro>

</robot>
