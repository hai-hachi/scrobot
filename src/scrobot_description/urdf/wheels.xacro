<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="scrobot_drive_wheel" params="name y mesh_file">
    <link name="${name}_wheel_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.155"/>
        <inertia
          ixx="1.37e-4"
          ixy="0"
          ixz="0"
          iyy="2.55e-4"
          iyz="0"
          izz="1.37e-4"/>
      </inertial>

      <visual name="${name}_wheel_visual">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://scrobot_description/meshes/visual/${mesh_file}" scale="1 1 1"/>
        </geometry>
        <material name="rubber_black"/>
      </visual>

      <collision name="${name}_wheel_collision">
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel_link"/>
      <origin xyz="0 ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.0" friction="0.0"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="scrobot_wheels">
    <xacro:scrobot_drive_wheel name="left" y="${wheel_separation / 2.0}" mesh_file="left_wheel.STL"/>
    <xacro:scrobot_drive_wheel name="right" y="${-wheel_separation / 2.0}" mesh_file="right_wheel.STL"/>
  </xacro:macro>
</robot>
