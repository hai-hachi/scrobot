<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="scrobot_collector">
    <link name="collector_link">
      <visual name="collector_visual">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://scrobot_description/meshes/visual/collector.STL" scale="1 1 1"/>
        </geometry>

        <material name="plastic_blue"/>
      </visual>

      <!-- Simple physical roller collision; detailed STL remains visual-only. -->
      <collision name="collector_collision">
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${collector_radius}" length="${collector_length}"/>
        </geometry>
      </collision>
    </link>

    <joint name="collector_joint" type="fixed">
      <parent link="base_link"/>
      <child link="collector_link"/>
      <origin xyz="${collector_x} ${collector_y} ${collector_z}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
</robot>
