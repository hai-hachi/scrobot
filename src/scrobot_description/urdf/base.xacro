<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="scrobot_base">

    <!--
      Planar navigation reference.

      This is primarily a TF frame, but because it is the root link of
      the URDF we give it a very small non-zero inertia for Gazebo.
    -->
    <link name="base_footprint">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.001"/>
        <inertia
          ixx="0.000001"
          ixy="0.0"
          ixz="0.0"
          iyy="0.000001"
          iyz="0.0"
          izz="0.000001"/>
      </inertial>
    </link>

    <joint name="base_footprint_joint" type="fixed">
      <parent link="base_footprint"/>
      <child link="base_link"/>
      <origin xyz="0 0 ${base_link_z}" rpy="0 0 0"/>
    </joint>

    <!-- Physical chassis -->
    <link name="base_link">

      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${base_length} ${base_width} ${base_height}"/>
        </geometry>
        <material name="scrobot_gray"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${base_length} ${base_width} ${base_height}"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>

        <!-- Placeholder mass -->
        <mass value="10.0"/>

        <!-- Inertia of a rectangular box -->
        <inertia
          ixx="${10.0 / 12.0 * (base_width * base_width + base_height * base_height)}"
          ixy="0.0"
          ixz="0.0"
          iyy="${10.0 / 12.0 * (base_length * base_length + base_height * base_height)}"
          iyz="0.0"
          izz="${10.0 / 12.0 * (base_length * base_length + base_width * base_width)}"/>
      </inertial>

    </link>

  </xacro:macro>

</robot>