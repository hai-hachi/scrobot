<?xml version="1.0"?>
<package format="3">
  <name>scrobot_bringup</name>
  <version>0.1.0</version>
  <description>Integrated physical-robot bringup for SC Robot on Raspberry Pi 4B.</description>
  <maintainer email="hai.hachi.154@gmail.com">sea</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>

  <exec_depend>scrobot_description</exec_depend>
  <exec_depend>scrobot_hardware</exec_depend>
  <exec_depend>scrobot_control</exec_depend>
  <exec_depend>scrobot_localization</exec_depend>
  <exec_depend>scrobot_perception</exec_depend>
  <exec_depend>scrobot_navigation</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
