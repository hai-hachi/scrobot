<?xml version="1.0"?>
<sdf version="1.10">
  <world name="yolo_dataset_native">
    <physics name="dataset_physics" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>0.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.08 0.08 0.08 1</ambient>
      <background>0.025 0.030 0.035 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Same six-side-light configuration as the simulation dataset world. -->
    <light type="spot" name="court_light_left_1">
      <pose>-4.5 4.6 7.0 0 0 0</pose>
      <diffuse>0.95 0.95 0.92 1</diffuse>
      <specular>0.20 0.20 0.20 1</specular>
      <direction>0 -0.55 -0.84</direction>
      <attenuation><range>18</range><constant>0.45</constant><linear>0.015</linear><quadratic>0.001</quadratic></attenuation>
      <spot><inner_angle>0.70</inner_angle><outer_angle>1.20</outer_angle><falloff>0.80</falloff></spot>
      <cast_shadows>true</cast_shadows>
    </light>
    <light type="spot" name="court_light_left_2">
      <pose>0 4.6 7.0 0 0 0</pose>
      <diffuse>0.95 0.95 0.92 1</diffuse>
      <specular>0.20 0.20 0.20 1</specular>
      <direction>0 -0.55 -0.84</direction>
      <attenuation><range>18</range><constant>0.45</constant><linear>0.015</linear><quadratic>0.001</quadratic></attenuation>
      <spot><inner_angle>0.70</inner_angle><outer_angle>1.20</outer_angle><falloff>0.80</falloff></spot>
      <cast_shadows>true</cast_shadows>
    </light>
    <light type="spot" name="court_light_left_3">
      <pose>4.5 4.6 7.0 0 0 0</pose>
      <diffuse>0.95 0.95 0.92 1</diffuse>
      <specular>0.20 0.20 0.20 1</specular>
      <direction>0 -0.55 -0.84</direction>
      <attenuation><range>18</range><constant>0.45</constant><linear>0.015</linear><quadratic>0.001</quadratic></attenuation>
      <spot><inner_angle>0.70</inner_angle><outer_angle>1.20</outer_angle><falloff>0.80</falloff></spot>
      <cast_shadows>true</cast_shadows>
    </light>
    <light type="spot" name="court_light_right_1">
      <pose>-4.5 -4.6 7.0 0 0 0</pose>
      <diffuse>0.95 0.95 0.92 1</diffuse>
      <specular>0.20 0.20 0.20 1</specular>
      <direction>0 0.55 -0.84</direction>
      <attenuation><range>18</range><constant>0.45</constant><linear>0.015</linear><quadratic>0.001</quadratic></attenuation>
      <spot><inner_angle>0.70</inner_angle><outer_angle>1.20</outer_angle><falloff>0.80</falloff></spot>
      <cast_shadows>true</cast_shadows>
    </light>
    <light type="spot" name="court_light_right_2">
      <pose>0 -4.6 7.0 0 0 0</pose>
      <diffuse>0.95 0.95 0.92 1</diffuse>
      <specular>0.20 0.20 0.20 1</specular>
      <direction>0 0.55 -0.84</direction>
      <attenuation><range>18</range><constant>0.45</constant><linear>0.015</linear><quadratic>0.001</quadratic></attenuation>
      <spot><inner_angle>0.70</inner_angle><outer_angle>1.20</outer_angle><falloff>0.80</falloff></spot>
      <cast_shadows>true</cast_shadows>
    </light>
    <light type="spot" name="court_light_right_3">
      <pose>4.5 -4.6 7.0 0 0 0</pose>
      <diffuse>0.95 0.95 0.92 1</diffuse>
      <specular>0.20 0.20 0.20 1</specular>
      <direction>0 0.55 -0.84</direction>
      <attenuation><range>18</range><constant>0.45</constant><linear>0.015</linear><quadratic>0.001</quadratic></attenuation>
      <spot><inner_angle>0.70</inner_angle><outer_angle>1.20</outer_angle><falloff>0.80</falloff></spot>
      <cast_shadows>true</cast_shadows>
    </light>

    <model name="dataset_court">
      <static>true</static>
      <link name="court_link">
        <visual name="mat">
          <pose>0 0 -0.001 0 0 0</pose>
          <geometry><box><size>15.4 7.2 0.002</size></box></geometry>
          <material><ambient>0.045 0.265 0.145 1</ambient><diffuse>0.055 0.345 0.185 1</diffuse></material>
        </visual>
        <collision name="court_collision">
          <pose>0 0 -0.006 0 0 0</pose>
          <geometry><box><size>15.4 7.2 0.01</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>0.9</mu><mu2>0.9</mu2></ode>
            </friction>
            <bounce><restitution_coefficient>0.0</restitution_coefficient></bounce>
          </surface>
        </collision>
        <visual name="line_y_p305"><pose>0 3.05 0.001 0 0 0</pose><geometry><box><size>13.44 0.04 0.002</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="line_y_n305"><pose>0 -3.05 0.001 0 0 0</pose><geometry><box><size>13.44 0.04 0.002</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="line_y_p259"><pose>0 2.59 0.001 0 0 0</pose><geometry><box><size>13.40 0.04 0.002</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="line_y_n259"><pose>0 -2.59 0.001 0 0 0</pose><geometry><box><size>13.40 0.04 0.002</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="line_x_p670"><pose>6.70 0 0.001 0 0 0</pose><geometry><box><size>0.04 6.14 0.002</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="line_x_n670"><pose>-6.70 0 0.001 0 0 0</pose><geometry><box><size>0.04 6.14 0.002</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="line_x_p198"><pose>1.98 0 0.001 0 0 0</pose><geometry><box><size>0.04 6.10 0.002</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="line_x_n198"><pose>-1.98 0 0.001 0 0 0</pose><geometry><box><size>0.04 6.10 0.002</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="line_x_p594"><pose>5.94 0 0.001 0 0 0</pose><geometry><box><size>0.04 6.10 0.002</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="line_x_n594"><pose>-5.94 0 0.001 0 0 0</pose><geometry><box><size>0.04 6.10 0.002</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="center_p"><pose>4.34 0 0.001 0 0 0</pose><geometry><box><size>4.72 0.04 0.002</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="center_n"><pose>-4.34 0 0.001 0 0 0</pose><geometry><box><size>4.72 0.04 0.002</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
      </link>
    </model>

    <model name="net_assembly">
      <static>true</static>
      <link name="net_link">
        <visual name="left_post"><pose>0 3.05 0.775 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>1.55</length></cylinder></geometry></visual>
        <visual name="right_post"><pose>0 -3.05 0.775 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>1.55</length></cylinder></geometry></visual>
        <visual name="net"><pose>0 0 1.17 0 0 0</pose><geometry><box><size>0.005 6.10 0.76</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material><transparency>0.65</transparency></visual>
      </link>
    </model>

    <include><uri>model://court_apriltags</uri></include>
    <include>
      <uri>model://yolo_bbox_camera_rig</uri>
      <name>yolo_bbox_camera_rig</name>
      <pose>2.0 0 0.28683059 0 0.2617993877991494 0</pose>
    </include>
  </world>
</sdf>
