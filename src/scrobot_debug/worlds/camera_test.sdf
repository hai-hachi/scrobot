<?xml version="1.0"?>
<sdf version="1.10">
  <world name="camera_test">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Publish shuttle GT for range testing, but never remove a shuttle. -->
    <plugin filename="libshuttle_activity_system.so"
            name="scrobot_simulation::ShuttleActivitySystem">
      <robot_model>scrobot</robot_model>
      <update_rate>30.0</update_rate>
      <ground_truth_topic>/evaluation/shuttle_ground_truth_gz</ground_truth_topic>
      <collected_topic>/evaluation/shuttle_collected_gz</collected_topic>
      <collector_link>collector_link</collector_link>
      <pickup_half_length>0.030</pickup_half_length>
      <pickup_half_width>0.150</pickup_half_width>
      <shuttle_center_offset_z>0.045</shuttle_center_offset_z>
      <enable_collection>false</enable_collection>
    </plugin>

    <scene>
      <ambient>0.12 0.12 0.12 1</ambient>
      <background>0.03 0.035 0.04 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="camera_test_light">
      <pose>0 0 6 0 0 0</pose>
      <diffuse>0.95 0.95 0.92 1</diffuse>
      <specular>0.12 0.12 0.12 1</specular>
      <direction>-0.15 0.10 -1.0</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <model name="camera_test_floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="floor_collision">
          <geometry>
            <box><size>12 8 0.02</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>

        <visual name="floor_visual">
          <geometry>
            <box><size>12 8 0.02</size></box>
          </geometry>
          <material>
            <ambient>0.045 0.265 0.145 1</ambient>
            <diffuse>0.055 0.345 0.185 1</diffuse>
            <specular>0.015 0.015 0.015 1</specular>
          </material>
        </visual>
      </link>
      <pose>0 0 -0.01 0 0 0</pose>
    </model>

    <!-- Distance references on the robot +X centerline. -->
    <model name="camera_range_marks">
      <static>true</static>
      <link name="marks">
        <visual name="mark_025">
          <pose>0.25 0 0.001 0 0 0</pose>
          <geometry><box><size>0.01 0.30 0.002</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="mark_050">
          <pose>0.50 0 0.001 0 0 0</pose>
          <geometry><box><size>0.01 0.30 0.002</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="mark_100">
          <pose>1.00 0 0.001 0 0 0</pose>
          <geometry><box><size>0.01 0.30 0.002</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="mark_150">
          <pose>1.50 0 0.001 0 0 0</pose>
          <geometry><box><size>0.01 0.30 0.002</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="mark_200">
          <pose>2.00 0 0.001 0 0 0</pose>
          <geometry><box><size>0.01 0.30 0.002</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="mark_300">
          <pose>3.00 0 0.001 0 0 0</pose>
          <geometry><box><size>0.01 0.30 0.002</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
