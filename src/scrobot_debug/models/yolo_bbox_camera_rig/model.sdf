<?xml version="1.0"?>
<sdf version="1.10">
  <model name="yolo_bbox_camera_rig">
    <!-- Non-static so /set_pose updates the rendering sensor reliably. -->
    <static>false</static>
    <link name="camera_frame">
      <gravity>false</gravity>
      <kinematic>true</kinematic>
      <inertial>
        <mass>0.10</mass>
        <inertia>
          <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz>
        </inertia>
      </inertial>

      <sensor name="d435i_bbox_dataset" type="boundingbox_camera">
        <always_on>true</always_on>
        <update_rate>30.0</update_rate>
        <topic>/yolo/bbox</topic>

        <camera>
          <triggered>true</triggered>
          <trigger_topic>/yolo/bbox/trigger</trigger_topic>
          <box_type>visible_2d</box_type>

          <horizontal_fov>1.229041640167034</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>20.0</far>
          </clip>

          <!-- Gazebo writes clean RGB + matching boxes from the same update. -->
          <save enabled="true">
            <path>/tmp/scrobot_yolo_bbox_raw</path>
          </save>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
