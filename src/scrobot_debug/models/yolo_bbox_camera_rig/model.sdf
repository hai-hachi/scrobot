<?xml version="1.0"?>
<sdf version="1.10">
  <model name="yolo_bbox_camera_rig">
    <!-- Match the old fast dataset camera architecture: a static sensor rig
         teleported by UserCommands, with no physics participation. -->
    <static>true</static>
    <link name="camera_frame">

      <sensor name="d435i_bbox_dataset" type="boundingbox_camera">
        <always_on>true</always_on>
        <update_rate>30.0</update_rate>
        <topic>/yolo/bbox</topic>

        <camera>
          <triggered>true</triggered>
          <trigger_topic>/yolo/bbox/trigger</trigger_topic>
          <box_type>visible_2d</box_type>

          <horizontal_fov>1.229041640167034</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>20.0</far>
          </clip>

          <!-- Gazebo writes clean RGB + matching boxes from the same update. -->
          <save enabled="true">
            <path>/tmp/scrobot_yolo_bbox_raw</path>
          </save>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
