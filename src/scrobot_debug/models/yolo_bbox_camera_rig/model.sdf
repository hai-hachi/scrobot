<?xml version="1.0"?>
<sdf version="1.10">
  <model name="yolo_bbox_camera_rig">
    <static>true</static>
    <link name="camera_frame">

      <!-- Clean training RGB. -->
      <sensor name="d435i_dataset_rgb" type="camera">
        <always_on>true</always_on>
        <update_rate>60.0</update_rate>
        <topic>/yolo/rgb</topic>
        <camera>
          <triggered>true</triggered>
          <trigger_topic>/yolo/capture/trigger</trigger_topic>
          <horizontal_fov>1.229041640167034</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.05</near><far>20.0</far></clip>
        </camera>
      </sensor>

      <!-- Native Gazebo boxes from the same pose / scene. -->
      <sensor name="d435i_dataset_bbox" type="boundingbox_camera">
        <always_on>true</always_on>
        <update_rate>60.0</update_rate>
        <topic>/yolo/bbox</topic>
        <camera>
          <triggered>true</triggered>
          <trigger_topic>/yolo/capture/trigger</trigger_topic>
          <box_type>visible_2d</box_type>
          <horizontal_fov>1.229041640167034</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.05</near><far>20.0</far></clip>
        </camera>
      </sensor>

    </link>
  </model>
</sdf>
