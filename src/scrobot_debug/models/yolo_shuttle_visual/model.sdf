<?xml version="1.0"?>
<sdf version="1.10">
  <model name="yolo_shuttle_visual">
    <static>true</static>
    <link name="shuttle_link">
      <visual name="shuttle_visual">
        <geometry>
          <mesh>
            <uri>model://shuttle/meshes/shuttle.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.78 0.78 0.78 1</ambient>
          <diffuse>0.92 0.92 0.92 1</diffuse>
          <specular>0.02 0.02 0.02 1</specular>
          <pbr>
            <metal>
              <metalness>0.0</metalness>
              <roughness>0.92</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
