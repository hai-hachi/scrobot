<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>scrobot_debug</name>
  <version>0.0.0</version>
  <description>Debug and subsystem-validation launch files and monitors for SC Robot.</description>
  <maintainer email="hai.hachi.154@gmail.com">sea</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>vision_msgs</exec_depend>

  <exec_depend>scrobot_simulation</exec_depend>
  <exec_depend>scrobot_control</exec_depend>
  <exec_depend>scrobot_description</exec_depend>
  <exec_depend>scrobot_localization</exec_depend>
  <exec_depend>scrobot_perception</exec_depend>
  <exec_depend>scrobot_mission</exec_depend>
  <exec_depend>scrobot_navigation</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
