Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Robot Collision Model1
        - /Control Stack Debug Overlay1
        - /TF1
      Splitter Ratio: 0.62
    Tree Height: 760
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Base Grid
      Enabled: true
      Value: true
      Alpha: 0.35
      Cell Size: 0.1
      Color: 95; 95; 95
      Line Style:
        Line Width: 0.01
        Value: Lines
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>

    - Class: rviz_default_plugins/RobotModel
      Name: Robot Collision Model
      Enabled: true
      Value: true
      Alpha: 0.30
      Collision Enabled: true
      Description File: ""
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
      Mass Properties:
        Inertia: false
        Mass: false
      TF Prefix: ""
      Update Interval: 0
      Visual Enabled: false

    - Class: rviz_default_plugins/MarkerArray
      Name: Control Stack Debug Overlay
      Enabled: true
      Value: true
      Marker Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /debug/control_stack_viz
      Namespaces:
        base_footprint_outline: true
        scan_points: true
        slowdown_zone_fill: true
        slowdown_zone_outline: true
        stop_zone_fill: true
        stop_zone_outline: true
      Queue Size: 5

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Value: true
      Frame Timeout: 15
      Marker Scale: 0.08
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Filter (blacklist): ""
      Filter (whitelist): ""
      Frames:
        All Enabled: true
      Tree: {}

  Enabled: true
  Global Options:
    Background Color: 25; 25; 25
    Fixed Frame: base_footprint
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Safety Top Down
      Scale: 1.0
      Target Frame: base_footprint
      Value: TopDownOrtho (rviz_default_plugins)
      X: 0.18
      Y: 0
    Saved: ~

Window Geometry:
  Displays:
    collapsed: false
  Selection:
    collapsed: true
  Views:
    collapsed: false
  Height: 950
  Width: 1450
  X: 40
  Y: 40
