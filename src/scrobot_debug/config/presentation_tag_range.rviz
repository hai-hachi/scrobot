Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Court Grid
      Enabled: true
      Value: true
      Alpha: 0.25
      Cell Size: 1
      Color: 120; 120; 120
      Line Style:
        Line Width: 0.02
        Value: Lines
      Plane: XY
      Plane Cell Count: 24
      Reference Frame: <Fixed Frame>

    - Class: rviz_default_plugins/MarkerArray
      Name: Court / Net / Poles
      Enabled: true
      Value: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /court_markers

    - Class: rviz_default_plugins/RobotModel
      Name: Robot
      Enabled: true
      Value: true
      Alpha: 0.65
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      TF Prefix: ""
      Update Interval: 0
      Visual Enabled: true

    - Class: rviz_default_plugins/Marker
      Name: Selected AprilTag
      Enabled: true
      Value: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /debug/smc_tag/tag_marker

    - Class: rviz_default_plugins/Pose
      Name: Desired Tag Approach Pose
      Enabled: true
      Value: true
      Alpha: 1
      Color: 246; 211; 45
      Shape: Arrow
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /debug/smc_tag/ideal_base_pose

    - Class: rviz_default_plugins/Pose
      Name: Controller Goal
      Enabled: true
      Value: true
      Alpha: 1
      Color: 255; 85; 255
      Shape: Arrow
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /debug/tag_controller/goal_pose

    - Class: rviz_default_plugins/Path
      Name: Controller Reference
      Enabled: true
      Value: true
      Alpha: 1
      Buffer Length: 1
      Color: 255; 215; 0
      Line Style: Lines
      Line Width: 0.03
      Pose Style: None
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /debug/tag_controller/reference_path

    - Class: rviz_default_plugins/Path
      Name: Robot Trajectory
      Enabled: true
      Value: true
      Alpha: 1
      Buffer Length: 1
      Color: 0; 255; 255
      Line Style: Lines
      Line Width: 0.05
      Pose Style: None
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /debug/smc_tag/trajectory

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Value: true
      Frame Timeout: 15
      Marker Scale: 0.14
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Frames:
        All Enabled: true
      Tree: {}

  Enabled: true
  Global Options:
    Background Color: 40; 40; 40
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Angle: 0
      Class: rviz_default_plugins/TopDownOrtho
      Name: Near-10m Tag Test
      Near Clip Distance: 0.01
      Scale: 115
      Target Frame: map
      X: 3.35
      Y: 0.35
      Value: TopDownOrtho (rviz_default_plugins)
    Saved: ~

Window Geometry:
  Height: 900
  Width: 1500
  X: 40
  Y: 40
