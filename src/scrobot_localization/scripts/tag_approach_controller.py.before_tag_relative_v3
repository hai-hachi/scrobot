#!/usr/bin/env python3

import math
import threading
import time

import rclpy
from apriltag_msgs.msg import AprilTagDetectionArray
from geometry_msgs.msg import TwistStamped
from rclpy.action import ActionServer, CancelResponse, GoalResponse
from rclpy.callback_groups import ReentrantCallbackGroup
from rclpy.duration import Duration
from rclpy.executors import SingleThreadedExecutor
from rclpy.node import Node
from rclpy.qos import DurabilityPolicy, QoSProfile, ReliabilityPolicy
from rclpy.task import Future
from rclpy.time import Time
from scrobot_interfaces.action import ApproachTag
from tf2_ros import Buffer, TransformException, TransformListener
from tf_transformations import (
    concatenate_matrices,
    inverse_matrix,
    quaternion_from_euler,
    quaternion_matrix,
    translation_matrix,
)


def clamp(value, low, high):
    return max(low, min(high, value))


def wrap_angle(angle):
    return math.atan2(math.sin(angle), math.cos(angle))


def transform_to_matrix(transform):
    translation = [
        transform.translation.x,
        transform.translation.y,
        transform.translation.z,
    ]
    quaternion = [
        transform.rotation.x,
        transform.rotation.y,
        transform.rotation.z,
        transform.rotation.w,
    ]
    return concatenate_matrices(
        translation_matrix(translation),
        quaternion_matrix(quaternion),
    )


def xyz_rpy_to_matrix(xyz, rpy):
    quaternion = quaternion_from_euler(rpy[0], rpy[1], rpy[2])
    return concatenate_matrices(
        translation_matrix(xyz),
        quaternion_matrix(quaternion),
    )


class TagApproachController(Node):
    VALID_TAG_IDS = (0, 1, 2, 3)

    def __init__(self):
        super().__init__('tag_approach_controller')
        self.cb_group = ReentrantCallbackGroup()

        self.declare_parameter('base_frame', 'base_footprint')
        self.declare_parameter('detections_topic', '/apriltag/detections')
        self.declare_parameter('observed_tag_prefix', 'observed_tag_')
        self.declare_parameter('cmd_vel_topic', '/cmd_vel_relocalization')

        self.declare_parameter('min_decision_margin', 10.0)
        self.declare_parameter('ready_decision_margin', 20.0)
        self.declare_parameter('max_detection_distance', 9.0)
        self.declare_parameter('candidate_max_view_angle_deg', 65.0)
        self.declare_parameter('candidate_lock_frames', 3)
        self.declare_parameter('candidate_lost_timeout', 0.30)

        self.declare_parameter('default_target_distance', 1.70)
        self.declare_parameter('ready_max_distance', 2.0)
        self.declare_parameter('minimum_standoff_distance', 1.30)
        self.declare_parameter('distance_tolerance', 0.10)
        self.declare_parameter('final_max_view_angle_deg', 30.0)
        self.declare_parameter('final_bearing_tolerance_deg', 4.0)
        self.declare_parameter('stable_time', 0.40)

        self.declare_parameter('default_timeout', 60.0)
        self.declare_parameter('search_angular_velocity', 0.15)
        self.declare_parameter('tag_lost_timeout', 0.30)
        self.declare_parameter('unlock_timeout', 1.50)
        self.declare_parameter('lost_stop_time', 0.15)
        self.declare_parameter('reacquire_angular_velocity', 0.12)

        self.declare_parameter('max_linear_velocity', 0.25)
        self.declare_parameter('max_angular_velocity', 0.25)
        self.declare_parameter('k_distance', 0.80)
        self.declare_parameter('k_bearing', 1.20)
        self.declare_parameter('drive_bearing_limit_deg', 25.0)
        self.declare_parameter('quality_creep_velocity', 0.05)

        self.declare_parameter('viewpoint_max_linear_velocity', 0.15)
        self.declare_parameter('viewpoint_max_angular_velocity', 0.20)
        self.declare_parameter('viewpoint_position_tolerance', 0.12)
        self.declare_parameter('viewpoint_drive_heading_limit_deg', 50.0)
        self.declare_parameter('viewpoint_tag_bearing_limit_deg', 35.0)
        self.declare_parameter('k_viewpoint_position', 0.70)
        self.declare_parameter('k_viewpoint_heading', 1.00)
        self.declare_parameter('k_viewpoint_bearing', 0.70)

        self.declare_parameter('control_rate', 20.0)

        self.base_frame = str(self.get_parameter('base_frame').value)
        self.detections_topic = str(self.get_parameter('detections_topic').value)
        self.observed_tag_prefix = str(self.get_parameter('observed_tag_prefix').value)
        self.cmd_vel_topic = str(self.get_parameter('cmd_vel_topic').value)

        self.min_decision_margin = float(self.get_parameter('min_decision_margin').value)
        self.ready_decision_margin = float(self.get_parameter('ready_decision_margin').value)
        self.max_detection_distance = float(self.get_parameter('max_detection_distance').value)
        self.candidate_max_view_angle = math.radians(float(self.get_parameter('candidate_max_view_angle_deg').value))
        self.candidate_lock_frames = max(1, int(self.get_parameter('candidate_lock_frames').value))
        self.candidate_lost_timeout = float(self.get_parameter('candidate_lost_timeout').value)

        self.default_target_distance = float(self.get_parameter('default_target_distance').value)
        self.ready_max_distance = float(self.get_parameter('ready_max_distance').value)
        self.minimum_standoff_distance = float(self.get_parameter('minimum_standoff_distance').value)
        self.distance_tolerance = float(self.get_parameter('distance_tolerance').value)
        self.final_max_view_angle = math.radians(float(self.get_parameter('final_max_view_angle_deg').value))
        self.final_bearing_tolerance = math.radians(float(self.get_parameter('final_bearing_tolerance_deg').value))
        self.stable_time = float(self.get_parameter('stable_time').value)

        self.default_timeout = float(self.get_parameter('default_timeout').value)
        self.search_angular_velocity = float(self.get_parameter('search_angular_velocity').value)
        self.tag_lost_timeout = float(self.get_parameter('tag_lost_timeout').value)
        self.unlock_timeout = float(self.get_parameter('unlock_timeout').value)
        self.lost_stop_time = float(self.get_parameter('lost_stop_time').value)
        self.reacquire_angular_velocity = float(self.get_parameter('reacquire_angular_velocity').value)

        self.max_linear_velocity = float(self.get_parameter('max_linear_velocity').value)
        self.max_angular_velocity = float(self.get_parameter('max_angular_velocity').value)
        self.k_distance = float(self.get_parameter('k_distance').value)
        self.k_bearing = float(self.get_parameter('k_bearing').value)
        self.drive_bearing_limit = math.radians(float(self.get_parameter('drive_bearing_limit_deg').value))
        self.quality_creep_velocity = float(self.get_parameter('quality_creep_velocity').value)

        self.viewpoint_max_linear_velocity = float(self.get_parameter('viewpoint_max_linear_velocity').value)
        self.viewpoint_max_angular_velocity = float(self.get_parameter('viewpoint_max_angular_velocity').value)
        self.viewpoint_position_tolerance = float(self.get_parameter('viewpoint_position_tolerance').value)
        self.viewpoint_drive_heading_limit = math.radians(float(self.get_parameter('viewpoint_drive_heading_limit_deg').value))
        self.viewpoint_tag_bearing_limit = math.radians(float(self.get_parameter('viewpoint_tag_bearing_limit_deg').value))
        self.k_viewpoint_position = float(self.get_parameter('k_viewpoint_position').value)
        self.k_viewpoint_heading = float(self.get_parameter('k_viewpoint_heading').value)
        self.k_viewpoint_bearing = float(self.get_parameter('k_viewpoint_bearing').value)

        control_rate = float(self.get_parameter('control_rate').value)

        self.T_mount_apriltag = xyz_rpy_to_matrix(
            [0.0, 0.0, 0.0],
            [-math.pi / 2.0, 0.0, -math.pi / 2.0],
        )

        self.tf_buffer = Buffer()
        self.tf_listener = TransformListener(self.tf_buffer, self, spin_thread=False)

        self.lock = threading.Lock()
        self.active = False
        self.preferred_tag_id = -1
        self.target_distance = self.default_target_distance
        self.current_goal_handle = None
        self.action_future = None
        self.action_deadline = None

        self.phase = 'idle'
        self.candidate_tag_id = -1
        self.candidate_count = 0
        self.last_candidate_seen = None

        self.locked_tag_id = -1
        self.last_tag_seen = None
        self.lock_lost_since = None
        self.last_distance = float('nan')
        self.last_bearing = float('nan')
        self.last_margin = float('nan')
        self.last_view_angle = float('nan')
        self.last_T_base_mount = None

        self.settle_since = None
        self.reacquire_started = None

        latest_qos = QoSProfile(
            depth=1,
            reliability=ReliabilityPolicy.RELIABLE,
            durability=DurabilityPolicy.VOLATILE,
        )
        control_qos = QoSProfile(
            depth=1,
            reliability=ReliabilityPolicy.RELIABLE,
            durability=DurabilityPolicy.VOLATILE,
        )

        self.cmd_pub = self.create_publisher(TwistStamped, self.cmd_vel_topic, control_qos)
        self.detection_sub = self.create_subscription(
            AprilTagDetectionArray,
            self.detections_topic,
            self.detection_callback,
            latest_qos,
            callback_group=self.cb_group,
        )

        self.control_timer = self.create_timer(
            1.0 / control_rate,
            self.control_loop,
            callback_group=self.cb_group,
        )
        self.control_timer.cancel()

        self.action_server = ActionServer(
            self,
            ApproachTag,
            '/approach_tag',
            execute_callback=self.execute_approach,
            goal_callback=self.goal_callback,
            cancel_callback=self.cancel_callback,
            callback_group=self.cb_group,
        )

        self.get_logger().info(
            'Tag approach controller V3 started: tag-relative approach, '
            'orientation-based selection, no odom/global target pose.'
        )

    def goal_callback(self, goal_request):
        with self.lock:
            if self.active:
                return GoalResponse.REJECT
        if goal_request.preferred_tag_id not in [-1, 0, 1, 2, 3]:
            return GoalResponse.REJECT
        return GoalResponse.ACCEPT

    def cancel_callback(self, goal_handle):
        return CancelResponse.ACCEPT

    async def execute_approach(self, goal_handle):
        target_distance = (
            float(goal_handle.request.target_distance)
            if goal_handle.request.target_distance > 0.0
            else self.default_target_distance
        )
        timeout = (
            float(goal_handle.request.timeout_sec)
            if goal_handle.request.timeout_sec > 0.0
            else self.default_timeout
        )
        future = Future()

        with self.lock:
            self.active = True
            self.preferred_tag_id = int(goal_handle.request.preferred_tag_id)
            self.target_distance = target_distance
            self.current_goal_handle = goal_handle
            self.action_future = future
            self.action_deadline = time.monotonic() + timeout

            self.phase = 'search'
            self.candidate_tag_id = -1
            self.candidate_count = 0
            self.last_candidate_seen = None
            self.locked_tag_id = -1
            self.last_tag_seen = None
            self.lock_lost_since = None
            self.last_distance = float('nan')
            self.last_bearing = float('nan')
            self.last_margin = float('nan')
            self.last_view_angle = float('nan')
            self.last_T_base_mount = None
            self.settle_since = None
            self.reacquire_started = None

        self.control_timer.reset()
        self.get_logger().info(
            f'ApproachTag V3 started: preferred_tag={self.preferred_tag_id}, '
            f'target_distance={target_distance:.2f} m'
        )
        return await future

    def compute_view_angle(self, T_base_mount):
        p = T_base_mount[:3, 3]
        distance = math.sqrt(float(p[0] * p[0] + p[1] * p[1] + p[2] * p[2]))
        if distance < 1e-6:
            return math.pi

        normal = T_base_mount[:3, 0]
        to_robot = [
            -float(p[0]) / distance,
            -float(p[1]) / distance,
            -float(p[2]) / distance,
        ]
        dot = clamp(
            float(normal[0]) * to_robot[0]
            + float(normal[1]) * to_robot[1]
            + float(normal[2]) * to_robot[2],
            -1.0,
            1.0,
        )
        return math.acos(dot)

    def measurement_from_detection(self, detection, stamp):
        tag_id = int(detection.id)
        if tag_id not in self.VALID_TAG_IDS or detection.hamming != 0:
            return None

        margin = float(detection.decision_margin)
        if margin < self.min_decision_margin:
            return None

        observed_tag_frame = self.observed_tag_prefix + str(tag_id)
        if not self.tf_buffer.can_transform(
            self.base_frame,
            observed_tag_frame,
            stamp,
            timeout=Duration(seconds=0.0),
        ):
            return None

        try:
            tf_base_april = self.tf_buffer.lookup_transform(
                self.base_frame,
                observed_tag_frame,
                stamp,
                timeout=Duration(seconds=0.0),
            )
        except TransformException:
            return None

        T_base_april = transform_to_matrix(tf_base_april.transform)
        T_base_mount = T_base_april @ inverse_matrix(self.T_mount_apriltag)

        p = T_base_mount[:3, 3]
        distance = math.sqrt(float(p[0] * p[0] + p[1] * p[1] + p[2] * p[2]))
        if distance > self.max_detection_distance:
            return None

        bearing = math.atan2(float(p[1]), float(p[0]))
        view_angle = self.compute_view_angle(T_base_mount)

        return {
            'id': tag_id,
            'distance': distance,
            'bearing': bearing,
            'margin': margin,
            'view_angle': view_angle,
            'T_base_mount': T_base_mount,
        }

    def update_locked_measurement(self, measurement, now):
        self.last_tag_seen = now
        self.lock_lost_since = None
        self.last_distance = float(measurement['distance'])
        self.last_bearing = float(measurement['bearing'])
        self.last_margin = float(measurement['margin'])
        self.last_view_angle = float(measurement['view_angle'])
        self.last_T_base_mount = measurement['T_base_mount'].copy()

    def detection_callback(self, msg):
        with self.lock:
            if not self.active:
                return
            preferred = self.preferred_tag_id
            locked_id = self.locked_tag_id

        stamp = Time.from_msg(msg.header.stamp)
        measurements = []
        for detection in msg.detections:
            m = self.measurement_from_detection(detection, stamp)
            if m is None:
                continue
            if preferred >= 0 and m['id'] != preferred:
                continue
            measurements.append(m)

        now = time.monotonic()

        if locked_id >= 0:
            locked = next((m for m in measurements if m['id'] == locked_id), None)
            if locked is None:
                return
            with self.lock:
                if not self.active or self.locked_tag_id != locked_id:
                    return
                self.update_locked_measurement(locked, now)
            return

        candidates = [
            m for m in measurements
            if m['view_angle'] <= self.candidate_max_view_angle
        ]
        if not candidates:
            return

        # Primary criterion: best physical tag-face orientation to the robot.
        # Tie breakers: higher decision margin, then shorter distance.
        best = min(
            candidates,
            key=lambda m: (m['view_angle'], -m['margin'], m['distance']),
        )

        stop_now = False
        locked_now = False
        with self.lock:
            if not self.active or self.locked_tag_id >= 0:
                return

            if self.phase == 'search':
                self.phase = 'select'
                stop_now = True

            if best['id'] == self.candidate_tag_id:
                self.candidate_count += 1
            else:
                self.candidate_tag_id = best['id']
                self.candidate_count = 1

            self.last_candidate_seen = now

            if self.candidate_count >= self.candidate_lock_frames:
                self.locked_tag_id = best['id']
                self.phase = 'approach'
                self.candidate_tag_id = -1
                self.candidate_count = 0
                self.update_locked_measurement(best, now)
                locked_now = True

        if stop_now:
            # Stop immediately on the first credible candidate instead of
            # waiting for the next 20 Hz control timer tick.
            self.publish_cmd(0.0, 0.0)

        if locked_now:
            self.get_logger().info(
                f'Locked tag {best["id"]}: '
                f'view={math.degrees(best["view_angle"]):.1f} deg, '
                f'margin={best["margin"]:.1f}, '
                f'distance={best["distance"]:.2f} m.'
            )

    def control_loop(self):
        with self.lock:
            if not self.active:
                return
            goal_handle = self.current_goal_handle
            deadline = self.action_deadline
            phase = self.phase
            candidate_seen = self.last_candidate_seen
            locked_id = self.locked_tag_id
            last_seen = self.last_tag_seen
            distance = self.last_distance
            bearing = self.last_bearing
            margin = self.last_margin
            view_angle = self.last_view_angle
            T_base_mount = None if self.last_T_base_mount is None else self.last_T_base_mount.copy()

        if goal_handle is None:
            return

        now = time.monotonic()
        feedback = ApproachTag.Feedback()
        feedback.tag_id = int(locked_id)
        feedback.distance = float(distance if math.isfinite(distance) else -1.0)
        feedback.bearing = float(bearing if math.isfinite(bearing) else 0.0)
        feedback.phase = phase
        goal_handle.publish_feedback(feedback)

        if goal_handle.is_cancel_requested:
            self.finish_approach(False, 'Approach canceled.', canceled=True)
            return

        if deadline is not None and now >= deadline:
            self.finish_approach(False, f'Approach timed out in phase {phase}.')
            return

        if phase == 'search':
            self.publish_cmd(0.0, self.search_angular_velocity)
            return

        if phase == 'select':
            self.publish_cmd(0.0, 0.0)
            if candidate_seen is None or now - candidate_seen > self.candidate_lost_timeout:
                with self.lock:
                    self.phase = 'search'
                    self.candidate_tag_id = -1
                    self.candidate_count = 0
                    self.last_candidate_seen = None
            return

        if locked_id < 0:
            with self.lock:
                self.phase = 'search'
            self.publish_cmd(0.0, 0.0)
            return

        recent = last_seen is not None and now - last_seen <= self.tag_lost_timeout
        if not recent or T_base_mount is None:
            self.handle_locked_tag_loss(now)
            return

        if phase == 'reacquire':
            with self.lock:
                self.phase = 'approach'
                self.reacquire_started = None
            self.publish_cmd(0.0, 0.0)
            return

        if phase == 'approach':
            self.run_center_approach(distance, bearing, margin, view_angle)
        elif phase == 'viewpoint':
            self.run_viewpoint_correction(distance, bearing, margin, view_angle, T_base_mount)
        elif phase == 'final_align':
            self.run_final_align(distance, bearing, margin, view_angle)
        elif phase == 'settle':
            self.run_settle(now, distance, bearing, margin, view_angle)
        else:
            self.publish_cmd(0.0, 0.0)

    def handle_locked_tag_loss(self, now):
        with self.lock:
            if self.lock_lost_since is None:
                self.lock_lost_since = now
            lost_for = now - self.lock_lost_since
            bearing = self.last_bearing

            if lost_for >= self.unlock_timeout:
                old_tag = self.locked_tag_id
                self.locked_tag_id = -1
                self.phase = 'search'
                self.last_tag_seen = None
                self.last_T_base_mount = None
                self.reacquire_started = None
                self.settle_since = None
                unlock = True
                reacquire_started = None
            else:
                if self.phase != 'reacquire':
                    self.phase = 'reacquire'
                    self.reacquire_started = now
                reacquire_started = self.reacquire_started
                unlock = False

        if unlock:
            self.get_logger().warn(
                f'Lost locked tag {old_tag}; releasing lock and resuming search.'
            )
            self.publish_cmd(0.0, 0.0)
            return

        if reacquire_started is None or now - reacquire_started < self.lost_stop_time:
            self.publish_cmd(0.0, 0.0)
            return

        direction = 1.0
        if math.isfinite(bearing) and abs(bearing) > math.radians(1.0):
            direction = 1.0 if bearing > 0.0 else -1.0
        self.publish_cmd(0.0, direction * self.reacquire_angular_velocity)

    def run_center_approach(self, distance, bearing, margin, view_angle):
        target = self.target_distance
        quality_ready = margin >= self.ready_decision_margin and distance <= self.ready_max_distance
        close_enough = distance <= target + self.distance_tolerance

        if quality_ready and close_enough:
            self.publish_cmd(0.0, 0.0)
            with self.lock:
                self.settle_since = None
                self.phase = 'final_align' if view_angle <= self.final_max_view_angle else 'viewpoint'
            return

        angular = clamp(
            self.k_bearing * bearing,
            -self.max_angular_velocity,
            self.max_angular_velocity,
        )

        if abs(bearing) > self.drive_bearing_limit:
            linear = 0.0
        else:
            distance_error = max(0.0, distance - target)
            linear = clamp(
                self.k_distance * distance_error,
                0.0,
                self.max_linear_velocity,
            )
            linear *= max(0.20, math.cos(bearing))

            if (
                distance <= target + self.distance_tolerance
                and margin < self.ready_decision_margin
                and distance > self.minimum_standoff_distance
            ):
                linear = min(self.quality_creep_velocity, self.max_linear_velocity)

        self.publish_cmd(linear, angular)

    def run_viewpoint_correction(self, distance, bearing, margin, view_angle, T_base_mount):
        if (
            view_angle <= self.final_max_view_angle
            and distance <= self.ready_max_distance
            and margin >= self.ready_decision_margin
        ):
            with self.lock:
                self.phase = 'final_align'
                self.settle_since = None
            self.publish_cmd(0.0, 0.0)
            return

        # Desired base pose relative to the physical tag face:
        # target_distance along tag +X normal, facing back toward tag.
        T_mount_goal = xyz_rpy_to_matrix(
            [self.target_distance, 0.0, 0.0],
            [0.0, 0.0, math.pi],
        )
        T_base_goal = T_base_mount @ T_mount_goal

        dx = float(T_base_goal[0, 3])
        dy = float(T_base_goal[1, 3])
        rho = math.hypot(dx, dy)
        heading_error = math.atan2(dy, dx) if rho > 1e-6 else 0.0

        if rho <= self.viewpoint_position_tolerance:
            with self.lock:
                self.phase = 'final_align'
                self.settle_since = None
            self.publish_cmd(0.0, 0.0)
            return

        # Arc-like correction: head toward the ideal standoff point while also
        # keeping the locked tag near the forward camera center.
        angular = (
            self.k_viewpoint_heading * heading_error
            + self.k_viewpoint_bearing * bearing
        )
        angular = clamp(
            angular,
            -self.viewpoint_max_angular_velocity,
            self.viewpoint_max_angular_velocity,
        )

        if (
            abs(heading_error) > self.viewpoint_drive_heading_limit
            or abs(bearing) > self.viewpoint_tag_bearing_limit
        ):
            linear = 0.0
        else:
            linear = clamp(
                self.k_viewpoint_position * rho,
                0.0,
                self.viewpoint_max_linear_velocity,
            )
            linear *= max(0.20, math.cos(heading_error))

        self.publish_cmd(linear, angular)

    def run_final_align(self, distance, bearing, margin, view_angle):
        if view_angle > self.final_max_view_angle:
            with self.lock:
                self.phase = 'viewpoint'
                self.settle_since = None
            self.publish_cmd(0.0, 0.0)
            return

        if distance > self.ready_max_distance or margin < self.ready_decision_margin:
            with self.lock:
                self.phase = 'approach'
                self.settle_since = None
            self.publish_cmd(0.0, 0.0)
            return

        if abs(bearing) > self.final_bearing_tolerance:
            angular = clamp(
                self.k_bearing * bearing,
                -self.max_angular_velocity,
                self.max_angular_velocity,
            )
            self.publish_cmd(0.0, angular)
            return

        with self.lock:
            self.phase = 'settle'
            self.settle_since = time.monotonic()
        self.publish_cmd(0.0, 0.0)

    def run_settle(self, now, distance, bearing, margin, view_angle):
        good = (
            distance <= self.ready_max_distance
            and margin >= self.ready_decision_margin
            and view_angle <= self.final_max_view_angle
            and abs(bearing) <= self.final_bearing_tolerance
        )

        if not good:
            with self.lock:
                self.settle_since = None
                self.phase = 'viewpoint' if view_angle > self.final_max_view_angle else 'final_align'
            self.publish_cmd(0.0, 0.0)
            return

        self.publish_cmd(0.0, 0.0)
        with self.lock:
            settle_since = self.settle_since

        if settle_since is not None and now - settle_since >= self.stable_time:
            self.finish_approach(
                True,
                'Stable tag observation pose reached: '
                f'tag={self.locked_tag_id}, '
                f'd={distance:.2f} m, '
                f'bearing={math.degrees(bearing):.1f} deg, '
                f'view={math.degrees(view_angle):.1f} deg, '
                f'margin={margin:.1f}.',
            )

    def finish_approach(self, success, message, canceled=False):
        self.stop_robot()
        with self.lock:
            if not self.active:
                return

            goal_handle = self.current_goal_handle
            future = self.action_future
            tag_id = self.locked_tag_id
            distance = self.last_distance
            bearing = self.last_bearing

            self.active = False
            self.preferred_tag_id = -1
            self.current_goal_handle = None
            self.action_future = None
            self.action_deadline = None
            self.phase = 'idle'
            self.candidate_tag_id = -1
            self.candidate_count = 0
            self.last_candidate_seen = None
            self.locked_tag_id = -1
            self.last_tag_seen = None
            self.lock_lost_since = None
            self.last_T_base_mount = None
            self.settle_since = None
            self.reacquire_started = None

        self.control_timer.cancel()

        result = ApproachTag.Result()
        result.success = bool(success)
        result.tag_id = int(tag_id)
        result.final_distance = float(distance if math.isfinite(distance) else -1.0)
        result.final_bearing = float(bearing if math.isfinite(bearing) else 0.0)
        result.message = message

        if goal_handle is not None:
            if canceled:
                goal_handle.canceled()
            elif success:
                goal_handle.succeed()
            else:
                goal_handle.abort()

        if future is not None and not future.done():
            future.set_result(result)

    def publish_cmd(self, linear_x, angular_z):
        msg = TwistStamped()
        msg.header.stamp = self.get_clock().now().to_msg()
        msg.header.frame_id = self.base_frame
        msg.twist.linear.x = float(linear_x)
        msg.twist.angular.z = float(angular_z)
        self.cmd_pub.publish(msg)

    def stop_robot(self):
        self.publish_cmd(0.0, 0.0)


def main(args=None):
    rclpy.init(args=args)
    node = TagApproachController()
    executor = SingleThreadedExecutor()
    executor.add_node(node)
    try:
        executor.spin()
    except KeyboardInterrupt:
        pass
    finally:
        node.stop_robot()
        executor.shutdown()
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
