<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>scrobot_simulation</name>
  <version>0.0.0</version>
  <description>Gazebo Harmonic runtime simulation for SC Robot: world, robot spawn, sensors, bridges, shuttle models, and simulation plugins.</description>
  <maintainer email="hai.hachi.154@gmail.com">sea</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>gz-plugin2</build_depend>
  <build_depend>gz-sim8</build_depend>
  <build_depend>gz-msgs10</build_depend>
  <build_depend>gz-transport13</build_depend>
  <build_depend>scrobot_localization</build_depend>
  <exec_depend>gz-plugin2</exec_depend>
  <exec_depend>gz-sim8</exec_depend>
  <exec_depend>gz-msgs10</exec_depend>
  <exec_depend>gz-transport13</exec_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <exec_depend>scrobot_description</exec_depend>
  <exec_depend>scrobot_localization</exec_depend>
  <exec_depend>scrobot_control</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>

  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_image</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>

  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>

  <exec_depend>depth_image_proc</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>
  <depend>python3-opencv</depend>
  <depend>python3-numpy</depend>
  <depend>python3-yaml</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
