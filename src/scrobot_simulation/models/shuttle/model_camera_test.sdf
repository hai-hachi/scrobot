<?xml version="1.0"?>
<sdf version="1.9">
  <model name="shuttle_camera_target">
    <static>true</static>
    <link name="shuttle_link">
      <!--
        Visual-only, non-colliding shuttle used for camera frame/range tests.
        ShuttleActivitySystem still sees shuttle_link and publishes its ground
        truth, but the target cannot be pushed by the robot or floor.
      -->
      <visual name="shuttle_visual">
        <geometry>
          <mesh><uri>model://shuttle/meshes/shuttle.STL</uri></mesh>
        </geometry>
        <material>
          <ambient>0.78 0.78 0.78 1</ambient>
          <diffuse>0.92 0.92 0.92 1</diffuse>
          <specular>0.02 0.02 0.02 1</specular>
          <pbr><metal><metalness>0.0</metalness><roughness>0.92</roughness></metal></pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
