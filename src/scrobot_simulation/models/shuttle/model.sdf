<?xml version="1.0"?>
<sdf version="1.9">
  <model name="shuttle">
    <static>false</static>
    <self_collide>false</self_collide>
    <allow_auto_disable>true</allow_auto_disable>

    <link name="shuttle_link">
      <!--
        Mesh convention:
          - model origin is at the rounded cork tip
          - +Z follows the shuttle axis toward the skirt
          - total shuttle length is approximately 90 mm

        Default spawner orientation is pitch = pi/2, so the shuttle lies on its side.
      -->

      <!-- User-tuned physical properties. -->
      <inertial>
        <pose>0 0 0.0296 0 0 0</pose>
        <mass>0.005</mass>
        <inertia>
          <ixx>1.02123536e-5</ixx>
          <iyy>1.02123536e-5</iyy>
          <izz>7.36831510e-6</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>

      <velocity_decay>
        <linear>0.35</linear>
        <angular>0.55</angular>
      </velocity_decay>

      <!-- Detailed visual variant: use for appearance / later YOLO camera tests. -->
      <visual name="shuttle_visual">
        <geometry>
          <mesh>
            <uri>model://shuttle/meshes/shuttle.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.78 0.78 0.78 1.0</ambient>
          <diffuse>0.92 0.92 0.92 1.0</diffuse>
          <specular>0.02 0.02 0.02 1.0</specular>
          <emissive>0.0 0.0 0.0 1.0</emissive>
          <pbr>
            <metal>
              <metalness>0.0</metalness>
              <roughness>0.92</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!--
        Fast collision approximation using the measured dimensions:
          cork diameter  = 28 mm
          skirt diameter = 68 mm
          total length   = 90 mm

        Only two persistent contact shapes are used.  This is enough to define the
        side-resting geometry while minimizing floor-contact work.

        Collision filtering:
          category 0x0002 = shuttle
          mask     0xFFFD = collide with everything except other shuttles

        The floor and robot keep their default masks, so they still collide with
        shuttles.  Separate shuttle models should not generate shuttle-shuttle
        contacts when the selected physics backend honors SDFormat contact masks.
      -->

      <collision name="cork_collision">
        <pose>0 0 0.014 0 0 0</pose>
        <max_contacts>1</max_contacts>
        <geometry>
          <sphere>
            <radius>0.014</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.7</mu>
              <mu2>0.7</mu2>
            </ode>
          </friction>
          <bounce>
            <restitution_coefficient>0.0</restitution_coefficient>
            <threshold>1000000.0</threshold>
          </bounce>
          <contact>
            <collide_without_contact>false</collide_without_contact>
            <category_bitmask>0x0002</category_bitmask>
            <collide_bitmask>0xFFFD</collide_bitmask>
          </contact>
        </surface>
      </collision>

      <collision name="skirt_collision">
        <!-- 8 mm thick rim ending at the measured 90 mm total length. -->
        <pose>0 0 0.086 0 0 0</pose>
        <max_contacts>1</max_contacts>
        <geometry>
          <cylinder>
            <radius>0.034</radius>
            <length>0.008</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.7</mu>
              <mu2>0.7</mu2>
            </ode>
          </friction>
          <bounce>
            <restitution_coefficient>0.0</restitution_coefficient>
            <threshold>1000000.0</threshold>
          </bounce>
          <contact>
            <collide_without_contact>false</collide_without_contact>
            <category_bitmask>0x0002</category_bitmask>
            <collide_bitmask>0xFFFD</collide_bitmask>
          </contact>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
