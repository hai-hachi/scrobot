<?xml version="1.0"?>
<sdf version="1.9">
  <model name="shuttle">
    <static>false</static>
    <self_collide>false</self_collide>
    <allow_auto_disable>true</allow_auto_disable>

    <link name="shuttle_link">
      <!--
        Mesh convention:
          - mesh origin is at the rounded cork tip
          - +Z follows the shuttle longitudinal axis toward the skirt
        The spawner lays the shuttle on its side by default using pitch = pi/2.
      -->

      <!-- Keep the tuned mass, COM and inertia independent of collision simplification. -->
      <inertial>
        <pose>0 0 0.0296 0 0 0</pose>
        <mass>0.005</mass>
        <inertia>
          <ixx>1.02123536e-5</ixx>
          <iyy>1.02123536e-5</iyy>
          <izz>7.36831510e-6</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>

      <!-- Damping helps a dropped shuttle settle instead of jittering indefinitely. -->
      <velocity_decay>
        <linear>0.35</linear>
        <angular>0.55</angular>
      </velocity_decay>

      <!-- Detailed mesh is visual only. -->
      <visual name="shuttle_visual">
        <geometry>
          <mesh>
            <uri>model://shuttle/meshes/shuttle.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.78 0.78 0.78 1.0</ambient>
          <diffuse>0.92 0.92 0.92 1.0</diffuse>
          <specular>0.02 0.02 0.02 1.0</specular>
          <emissive>0.0 0.0 0.0 1.0</emissive>
          <pbr>
            <metal>
              <metalness>0.0</metalness>
              <roughness>0.92</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!--
        Fast collision approximation.

        The original triangle mesh collision was expensive because every dynamic
        shuttle rests against the floor continuously.  These three primitives keep
        the useful behaviour for this project while dramatically reducing contact
        complexity:
          1. cork end   : sphere, ~26 mm diameter
          2. body       : narrow cylinder along local +Z
          3. skirt rim  : short wide cylinder, ~65 mm diameter

        Primitive dimensions are intentionally easy to tune after visual/contact
        inspection.  They do not change the detailed rendered shuttle mesh.
      -->

      <collision name="cork_collision">
        <!-- Origin is at rounded tip; cork occupies roughly the first 25 mm. -->
        <pose>0 0 0.013 0 0 0</pose>
        <max_contacts>2</max_contacts>
        <geometry>
          <sphere>
            <radius>0.013</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.9</mu>
              <mu2>0.9</mu2>
            </ode>
          </friction>
          <bounce>
            <restitution_coefficient>0.0</restitution_coefficient>
            <threshold>1000000.0</threshold>
          </bounce>
          <contact>
            <collide_without_contact>false</collide_without_contact>
          </contact>
        </surface>
      </collision>

      <collision name="body_collision">
        <!-- Cheap axial collision so the base cannot pass through the shuttle middle. -->
        <pose>0 0 0.038 0 0 0</pose>
        <max_contacts>2</max_contacts>
        <geometry>
          <cylinder>
            <radius>0.006</radius>
            <length>0.040</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.9</mu>
              <mu2>0.9</mu2>
            </ode>
          </friction>
          <bounce>
            <restitution_coefficient>0.0</restitution_coefficient>
            <threshold>1000000.0</threshold>
          </bounce>
          <contact>
            <collide_without_contact>false</collide_without_contact>
          </contact>
        </surface>
      </collision>

      <collision name="skirt_collision">
        <!-- Wide rim provides the second stable floor contact when lying on its side. -->
        <pose>0 0 0.064 0 0 0</pose>
        <max_contacts>2</max_contacts>
        <geometry>
          <cylinder>
            <radius>0.0325</radius>
            <length>0.008</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.9</mu>
              <mu2>0.9</mu2>
            </ode>
          </friction>
          <bounce>
            <restitution_coefficient>0.0</restitution_coefficient>
            <threshold>1000000.0</threshold>
          </bounce>
          <contact>
            <collide_without_contact>false</collide_without_contact>
          </contact>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
