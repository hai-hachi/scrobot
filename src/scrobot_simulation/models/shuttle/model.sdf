<?xml version="1.0"?>
<sdf version="1.9">
  <model name="shuttle">
    <static>true</static>
    <self_collide>false</self_collide>
    <allow_auto_disable>true</allow_auto_disable>

    <link name="shuttle_link">
      <!--
        Validation / perception shuttle. The visual remains the detailed mesh
        used for future YOLO-in-simulation tests. The model is intentionally
        static on the court: a resting shuttle should not orbit or roll because
        of simplified feather collision geometry. Collection is handled by the
        ShuttleActivitySystem pickup envelope.
      -->
      <inertial>
        <pose>0 0 0.0296 0 0 0</pose>
        <mass>0.0052</mass>
        <inertia>
          <ixx>4.593333333333333e-6</ixx>
          <iyy>5.513733333333332e-6</iyy>
          <izz>3.0870666666666666e-6</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>

      <visual name="shuttle_visual">
        <geometry>
          <mesh><uri>model://shuttle/meshes/shuttle.STL</uri></mesh>
        </geometry>
        <material>
          <ambient>0.78 0.78 0.78 1.0</ambient>
          <diffuse>0.92 0.92 0.92 1.0</diffuse>
          <specular>0.02 0.02 0.02 1.0</specular>
          <emissive>0.0 0.0 0.0 1.0</emissive>
          <pbr><metal><metalness>0.0</metalness><roughness>0.92</roughness></metal></pbr>
        </material>
      </visual>

      <!-- New low-poly collision mesh supplied by the project:
           frustum r=28 mm, R=68 mm, h=90 mm with rounded head. -->
      <collision name="cork_collision">
        <pose>0 0 0.014 0 0 0</pose>
        <max_contacts>1</max_contacts>
        <geometry><sphere><radius>0.014</radius></sphere></geometry>
        <surface>
          <friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction>
          <bounce><restitution_coefficient>0.0</restitution_coefficient><threshold>1000000.0</threshold></bounce>
          <contact>
            <collide_without_contact>false</collide_without_contact>
            <category_bitmask>0x0002</category_bitmask>
            <collide_bitmask>0xFFFD</collide_bitmask>
          </contact>
        </surface>
      </collision>

      <collision name="skirt_collision">
        <pose>0 0 0.086 0 0 0</pose>
        <max_contacts>1</max_contacts>
        <geometry><cylinder><radius>0.034</radius><length>0.008</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction>
          <bounce><restitution_coefficient>0.0</restitution_coefficient><threshold>1000000.0</threshold></bounce>
          <contact>
            <collide_without_contact>false</collide_without_contact>
            <category_bitmask>0x0002</category_bitmask>
            <collide_bitmask>0xFFFD</collide_bitmask>
          </contact>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
