<?xml version="1.0"?>
<sdf version="1.9">
  <model name="shuttle">
    <static>false</static>
    <self_collide>false</self_collide>
    <allow_auto_disable>true</allow_auto_disable>

    <link name="shuttle_link">
      <!-- Keep the center of mass low so contact does not excite tumbling/orbiting. -->
      <inertial>
        <pose>0 0 0.010 0 0 0</pose>
        <mass>0.005</mass>
        <inertia>
          <ixx>2.0e-6</ixx>
          <iyy>2.0e-6</iyy>
          <izz>4.0e-6</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>

      <!-- Strong decay: a bumped shuttle can move, but should settle quickly. -->
      <velocity_decay>
        <linear>5.0</linear>
        <angular>10.0</angular>
      </velocity_decay>

      <visual name="shuttle_visual">
        <geometry>
          <mesh><uri>model://shuttle/meshes/shuttle.STL</uri></mesh>
        </geometry>
        <material>
          <ambient>0.78 0.78 0.78 1.0</ambient>
          <diffuse>0.92 0.92 0.92 1.0</diffuse>
          <specular>0.02 0.02 0.02 1.0</specular>
          <emissive>0.0 0.0 0.0 1.0</emissive>
          <pbr><metal><metalness>0.0</metalness><roughness>0.92</roughness></metal></pbr>
        </material>
      </visual>

      <!-- Simplified low physics footprint. The realistic visual stays unchanged,
           but the collision body no longer acts like a tall rolling/tumbling object. -->
      <collision name="shuttle_collision">
        <pose>0 0 0.010 0 0 0</pose>
        <max_contacts>4</max_contacts>
        <geometry>
          <cylinder>
            <radius>0.034</radius>
            <length>0.020</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>2.5</mu>
              <mu2>2.5</mu2>
            </ode>
          </friction>
          <bounce>
            <restitution_coefficient>0.0</restitution_coefficient>
            <threshold>1000000.0</threshold>
          </bounce>
          <contact>
            <collide_without_contact>false</collide_without_contact>
            <category_bitmask>0x0002</category_bitmask>
            <collide_bitmask>0xFFFD</collide_bitmask>
          </contact>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
