<?xml version="1.0"?>
<sdf version="1.9">
  <model name="shuttle">
    <static>false</static>
    <self_collide>false</self_collide>
    <allow_auto_disable>true</allow_auto_disable>

    <link name="shuttle_link">
      <inertial>
        <pose>0 0 0.0296 0 0 0</pose>
        <mass>0.050</mass>
        <inertia>
          <ixx>6.57e-5</ixx>
          <iyy>6.57e-5</iyy>
          <izz>7.37e-5</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>

      <velocity_decay>
        <linear>3.0</linear>
        <angular>5.0</angular>
      </velocity_decay>

      <!-- Fast visual: keep the simplified mesh but make it bright red so
           spawned shuttles are easy to see during coverage testing. -->
      <visual name="shuttle_visual_fast">
        <geometry>
          <mesh><uri>model://shuttle/meshes/shuttle_collision.STL</uri></mesh>
        </geometry>
        <material>
          <ambient>1.0 0.02 0.02 1.0</ambient>
          <diffuse>1.0 0.02 0.02 1.0</diffuse>
          <specular>0.05 0.00 0.00 1.0</specular>
          <emissive>0.15 0.00 0.00 1.0</emissive>
          <pbr><metal><metalness>0.0</metalness><roughness>0.85</roughness></metal></pbr>
        </material>
      </visual>

      <!-- Fast collision: simple shuttle bounding box, 68 x 68 x 90 mm. -->
      <collision name="shuttle_collision">
        <max_contacts>8</max_contacts>
        <geometry>
          <box>
            <size>0.068 0.068 0.090</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.2</mu2>
            </ode>
          </friction>
          <bounce>
            <restitution_coefficient>0.0</restitution_coefficient>
            <threshold>1000000.0</threshold>
          </bounce>
          <contact>
            <collide_without_contact>false</collide_without_contact>
            <category_bitmask>0x0002</category_bitmask>
            <collide_bitmask>0xFFFD</collide_bitmask>
          </contact>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
