<?xml version="1.0"?>
<sdf version="1.9">
  <model name="court_apriltags">
    <static>true</static>

    <plugin filename="libshuttle_activity_system.so"
            name="scrobot_simulation::ShuttleActivitySystem">
      <robot_model>scrobot</robot_model>
      <update_rate>10.0</update_rate>
      <!-- Keep resting shuttles frozen while Nav2 moves to the 0.75 m staging pose. -->
      <activation_distance>0.35</activation_distance>
      <freeze_distance>0.55</freeze_distance>
      <settle_time>0.75</settle_time>
    </plugin>

    <!-- ======================================================
         Tag 0

         Link frame IS the physical tag_mount_0 convention:
           +X outward from printed face
           +Y left (REP-103)
           +Z up

         Only yaw changes with inward angle.
         ====================================================== -->
    <link name="tag_mount_0">
      <pose>0.053033009 2.996966991 0.150000000 0 0 -0.785398163</pose>
      <visual name="backing">
        <pose>-0.001750 0 0 0 0 0</pose>
        <geometry><box><size>0.003000 0.133333333 0.133333333</size></box></geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
          <specular>0 0 0 1</specular>
        </material>
      </visual>
      <visual name="tag_texture">
        <geometry><mesh><uri>model://court_apriltags/meshes/tag_0.obj</uri></mesh></geometry>
      </visual>
    </link>

    <!-- ======================================================
         Tag 1
         ====================================================== -->
    <link name="tag_mount_1">
      <pose>0.053033009 -2.996966991 0.150000000 0 0 0.785398163</pose>
      <visual name="backing">
        <pose>-0.001750 0 0 0 0 0</pose>
        <geometry><box><size>0.003000 0.133333333 0.133333333</size></box></geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
          <specular>0 0 0 1</specular>
        </material>
      </visual>
      <visual name="tag_texture">
        <geometry><mesh><uri>model://court_apriltags/meshes/tag_1.obj</uri></mesh></geometry>
      </visual>
    </link>

    <!-- ======================================================
         Tag 2
         ====================================================== -->
    <link name="tag_mount_2">
      <pose>-0.053033009 2.996966991 0.150000000 0 0 -2.356194490</pose>
      <visual name="backing">
        <pose>-0.001750 0 0 0 0 0</pose>
        <geometry><box><size>0.003000 0.133333333 0.133333333</size></box></geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
          <specular>0 0 0 1</specular>
        </material>
      </visual>
      <visual name="tag_texture">
        <geometry><mesh><uri>model://court_apriltags/meshes/tag_2.obj</uri></mesh></geometry>
      </visual>
    </link>

    <!-- ======================================================
         Tag 3
         ====================================================== -->
    <link name="tag_mount_3">
      <pose>-0.053033009 -2.996966991 0.150000000 0 0 2.356194490</pose>
      <visual name="backing">
        <pose>-0.001750 0 0 0 0 0</pose>
        <geometry><box><size>0.003000 0.133333333 0.133333333</size></box></geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
          <specular>0 0 0 1</specular>
        </material>
      </visual>
      <visual name="tag_texture">
        <geometry><mesh><uri>model://court_apriltags/meshes/tag_3.obj</uri></mesh></geometry>
      </visual>
    </link>

  </model>
</sdf>
