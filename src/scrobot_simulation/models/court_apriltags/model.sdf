<?xml version="1.0"?>

<sdf version="1.9">

  <model name="court_apriltags">

    <static>true</static>


    <!-- ==================================================== -->
    <!-- TAG 0                                                -->
    <!-- Left post, facing Side A (+X)                        -->
    <!-- ==================================================== -->

    <link name="tag_0_link">

      <pose>
        0.030 3.050 0.120
        0 0 0
      </pose>

      <visual name="tag_0_visual">

        <cast_shadows>false</cast_shadows>

        <geometry>

          <plane>

            <!-- Visible from +X -->
            <normal>1 0 0</normal>

            <!--
              Full texture edge:
              50 mm x (8 / 6)
              = 66.67 mm
            -->
            <size>
              0.066667 0.066667
            </size>

          </plane>

        </geometry>


        <material>

          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>

          <pbr>

            <metal>

              <albedo_map>
                model://court_apriltags/materials/textures/tag0.png
              </albedo_map>

              <metalness>0.0</metalness>
              <roughness>1.0</roughness>

            </metal>

          </pbr>

        </material>

      </visual>

    </link>


    <!-- ==================================================== -->
    <!-- TAG 1                                                -->
    <!-- Right post, facing Side A (+X)                       -->
    <!-- ==================================================== -->

    <link name="tag_1_link">

      <pose>
        0.030 -3.050 0.120
        0 0 0
      </pose>

      <visual name="tag_1_visual">

        <cast_shadows>false</cast_shadows>

        <geometry>

          <plane>
            <normal>1 0 0</normal>
            <size>0.066667 0.066667</size>
          </plane>

        </geometry>

        <material>

          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>

          <pbr>

            <metal>

              <albedo_map>
                model://court_apriltags/materials/textures/tag1.png
              </albedo_map>

              <metalness>0.0</metalness>
              <roughness>1.0</roughness>

            </metal>

          </pbr>

        </material>

      </visual>

    </link>


    <!-- ==================================================== -->
    <!-- TAG 2                                                -->
    <!-- Left post, facing Side B (-X)                        -->
    <!-- ==================================================== -->

    <link name="tag_2_link">

      <pose>
        -0.030 3.050 0.120
        0 0 0
      </pose>

      <visual name="tag_2_visual">

        <cast_shadows>false</cast_shadows>

        <geometry>

          <plane>
            <normal>-1 0 0</normal>
            <size>0.066667 0.066667</size>
          </plane>

        </geometry>

        <material>

          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>

          <pbr>

            <metal>

              <albedo_map>
                model://court_apriltags/materials/textures/tag2.png
              </albedo_map>

              <metalness>0.0</metalness>
              <roughness>1.0</roughness>

            </metal>

          </pbr>

        </material>

      </visual>

    </link>


    <!-- ==================================================== -->
    <!-- TAG 3                                                -->
    <!-- Right post, facing Side B (-X)                       -->
    <!-- ==================================================== -->

    <link name="tag_3_link">

      <pose>
        -0.030 -3.050 0.120
        0 0 0
      </pose>

      <visual name="tag_3_visual">

        <cast_shadows>false</cast_shadows>

        <geometry>

          <plane>
