<?xml version="1.0"?>
<sdf version="1.9">
  <model name="court_apriltags">
    <static>true</static>

    <!-- ======================================================
         Tag 0

         Link frame IS the physical tag_mount_0 convention:
           +X outward from printed face
           +Y left (REP-103)
           +Z up

         Only yaw changes with inward angle.
         ====================================================== -->
    <link name="tag_mount_0">
      <pose>0.053033009 2.996966991 0.150000000 0 0 -0.785398163</pose>

      <!-- Thin opaque backing plate. It also prevents the marker from
           being visible from the physical back side. -->
      <visual name="backing">
        <pose>-0.001750 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.003000 0.133333333 0.133333333</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
          <specular>0 0 0 1</specular>
        </material>
      </visual>

      <!-- Explicitly UV-mapped front quad. No Gazebo plane-normal
           texture rotation is involved. -->
      <visual name="tag_texture">
        <geometry>
          <mesh>
            <uri>model://court_apriltags/meshes/tag_0.obj</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

