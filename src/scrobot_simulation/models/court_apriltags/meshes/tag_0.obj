# AprilTag 0
# Frame convention:
#   +X = visible face outward
#   +Y = image right when viewed from +X
#   +Z = image up
mtllib tag_0.mtl
o tag_0

# bottom-left, bottom-right, top-right, top-left as viewed from +X
v 0 -0.066666667 -0.066666667
v 0 0.066666667 -0.066666667
v 0 0.066666667 0.066666667
v 0 -0.066666667 0.066666667

# OBJ UV: (0,0) bottom-left, (1,1) top-right
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

vn 1.0 0.0 0.0

usemtl tag_0_material
# Counter-clockwise when viewed from +X -> normal +X
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
