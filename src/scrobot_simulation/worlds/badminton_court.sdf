<?xml version="1.0" ?>
<sdf version="1.10">

  <world name="badminton_court">

    <!-- Physics -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Geographic reference required by magnetometer -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>

      <latitude_deg>10.0</latitude_deg>
      <longitude_deg>106.0</longitude_deg>

      <elevation>0.0</elevation>

      <!-- +X of the Gazebo world corresponds to East -->
      <heading_deg>0.0</heading_deg>
    </spherical_coordinates>

    <!-- Required Gazebo systems -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>

    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu"/>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">

      <render_engine>ogre2</render_engine>

    </plugin>

    <plugin
      filename="gz-sim-magnetometer-system"
      name="gz::sim::systems::Magnetometer"/>

    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>

      <pose>0 0 10 0 0 0</pose>

      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>

      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Floor -->
    <model name="court_floor">

      <static>true</static>

      <link name="floor_link">

        <collision name="floor_collision">

          <geometry>
            <box>
              <size>18 10 0.02</size>
            </box>
          </geometry>

          <surface>

            <friction>

              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>

            </friction>

          </surface>

        </collision>

        <visual name="floor_visual">
          <geometry>
            <box>
              <size>18.0 10.0 0.02</size>
            </box>
          </geometry>

          <material>
            <ambient>0.15 0.45 0.25 1</ambient>
            <diffuse>0.15 0.45 0.25 1</diffuse>
          </material>
        </visual>

      </link>

      <pose>0 0 -0.01 0 0 0</pose>

    </model>

    <!-- <model name="test_box">

      <static>true</static>

      <pose>3 0 0.5 0 0 0</pose>

      <link name="link">

        <collision name="collision">

          <geometry>
            <box>
              <size>0.5 0.5 1.0</size>
            </box>
          </geometry>

        </collision>


        <visual name="visual">

          <geometry>
            <box>
              <size>0.5 0.5 1.0</size>
            </box>
          </geometry>

          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.8 0.2 0.2 1</diffuse>
          </material>

        </visual>

      </link>

    </model> -->

    <model name="court_markings">

      <static>true</static>

      <link name="markings">

        <!-- ================================================= -->
        <!-- Doubles sidelines: y = +/- 3.05                   -->
        <!-- ================================================= -->

        <visual name="doubles_sideline_left">
          <pose>0 3.05 0.0005 0 0 0</pose>

          <geometry>
            <box>
              <size>13.44 0.04 0.001</size>
            </box>
          </geometry>

          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>


        <visual name="doubles_sideline_right">
          <pose>0 -3.05 0.0005 0 0 0</pose>

          <geometry>
            <box>
              <size>13.44 0.04 0.001</size>
            </box>
          </geometry>

          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>


        <!-- ================================================= -->
        <!-- Singles sidelines: y = +/- 2.59                   -->
        <!-- ================================================= -->

        <visual name="singles_sideline_left">
          <pose>0 2.59 0.0005 0 0 0</pose>

          <geometry>
            <box>
              <size>13.40 0.04 0.001</size>
            </box>
          </geometry>

          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>


        <visual name="singles_sideline_right">
          <pose>0 -2.59 0.0005 0 0 0</pose>

          <geometry>
            <box>
              <size>13.40 0.04 0.001</size>
            </box>
          </geometry>

          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>


        <!-- ================================================= -->
        <!-- Back boundaries: x = +/- 6.70                     -->
        <!-- ================================================= -->

        <visual name="baseline_positive">
          <pose>6.70 0 0.0005 0 0 0</pose>

          <geometry>
            <box>
              <size>0.04 6.14 0.001</size>
            </box>
          </geometry>

          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>


        <visual name="baseline_negative">
          <pose>-6.70 0 0.0005 0 0 0</pose>

          <geometry>
            <box>
              <size>0.04 6.14 0.001</size>
            </box>
          </geometry>

          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>


        <!-- ================================================= -->
        <!-- Short service lines: +/-1.98 from net             -->
        <!-- ================================================= -->

        <visual name="short_service_positive">
          <pose>1.98 0 0.0005 0 0 0</pose>

          <geometry>
            <box>
              <size>0.04 6.10 0.001</size>
            </box>
          </geometry>

          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>


        <visual name="short_service_negative">
          <pose>-1.98 0 0.0005 0 0 0</pose>

          <geometry>
            <box>
              <size>0.04 6.10 0.001</size>
            </box>
          </geometry>

          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>


        <!-- ================================================= -->
        <!-- Doubles long service lines                        -->
        <!-- 6.70 - 0.76 = 5.94                                -->
        <!-- ================================================= -->

        <visual name="long_service_positive">
          <pose>5.94 0 0.0005 0 0 0</pose>

          <geometry>
            <box>
              <size>0.04 6.10 0.001</size>
            </box>
          </geometry>

          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>


        <visual name="long_service_negative">
          <pose>-5.94 0 0.0005 0 0 0</pose>

          <geometry>
            <box>
              <size>0.04 6.10 0.001</size>
            </box>
          </geometry>

          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>


        <!-- ================================================= -->
        <!-- Centre service lines                              -->
        <!-- midpoint between 1.98 and 6.70 = 4.34             -->
        <!-- length = 6.70 - 1.98 = 4.72                       -->
        <!-- ================================================= -->

        <visual name="center_service_positive">
          <pose>4.34 0 0.0005 0 0 0</pose>

          <geometry>
            <box>
              <size>4.72 0.04 0.001</size>
            </box>
          </geometry>

          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>


        <visual name="center_service_negative">
          <pose>-4.34 0 0.0005 0 0 0</pose>

          <geometry>
            <box>
              <size>4.72 0.04 0.001</size>
            </box>
          </geometry>

          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>

      </link>

    </model>

    <model name="net_assembly">

      <static>true</static>

      <link name="net_link">


        <!-- ================================================= -->
        <!-- LEFT POST                                         -->
        <!-- ================================================= -->

        <collision name="left_post_collision">

          <pose>0 3.05 0.775 0 0 0</pose>

          <geometry>
            <cylinder>
              <radius>0.050</radius>
              <length>1.55</length>
            </cylinder>
          </geometry>

        </collision>


        <visual name="left_post_visual">

          <pose>0 3.05 0.775 0 0 0</pose>

          <geometry>
            <cylinder>
              <radius>0.050</radius>
              <length>1.55</length>
            </cylinder>
          </geometry>

          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>

        </visual>


        <!-- ================================================= -->
        <!-- RIGHT POST                                        -->
        <!-- ================================================= -->

        <collision name="right_post_collision">

          <pose>0 -3.05 0.775 0 0 0</pose>

          <geometry>
            <cylinder>
              <radius>0.050</radius>
              <length>1.55</length>
            </cylinder>
          </geometry>

        </collision>


        <visual name="right_post_visual">

          <pose>0 -3.05 0.775 0 0 0</pose>

          <geometry>
            <cylinder>
              <radius>0.050</radius>
              <length>1.55</length>
            </cylinder>
          </geometry>

          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>

        </visual>


        <!-- ================================================= -->
        <!-- NET: VISUAL ONLY                                  -->
        <!-- ================================================= -->

        <visual name="net_visual">

          <!-- Top = 1.55 m, depth = 0.76 m -->
          <pose>0 0 1.17 0 0 0</pose>

          <geometry>
            <box>
              <size>0.005 6.10 0.76</size>
            </box>
          </geometry>

          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
          </material>

          <transparency>0.65</transparency>

        </visual>


        <!-- White top tape -->

        <visual name="net_top_tape">

          <pose>0 0 1.5125 0 0 0</pose>

          <geometry>
            <box>
              <size>0.01 6.10 0.075</size>
            </box>
          </geometry>

          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>

        </visual>


      </link>

    </model>


  </world>

</sdf>