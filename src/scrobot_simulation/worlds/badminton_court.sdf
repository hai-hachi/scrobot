<?xml version="1.0" ?>
<sdf version="1.10">

  <world name="badminton_court">

    <!-- Physics -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Geographic reference required by magnetometer -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>

      <latitude_deg>10.0</latitude_deg>
      <longitude_deg>106.0</longitude_deg>

      <elevation>0.0</elevation>

      <!-- +X of the Gazebo world corresponds to East -->
      <heading_deg>0.0</heading_deg>
    </spherical_coordinates>

    <!-- Required Gazebo systems -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>

    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu"/>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">

      <render_engine>ogre2</render_engine>

    </plugin>

    <plugin
      filename="gz-sim-magnetometer-system"
      name="gz::sim::systems::Magnetometer"/>

    <!--
      World-level shuttle manager. It publishes shuttle-only ground truth and
      removes a shuttle when its collection-center point enters the collector
      pickup rectangle. The shuttle collection center is defined 45 mm along
      local +Z from the shuttle model origin. The pickup rectangle is
      300 mm wide x 60 mm long and centered directly on collector_link.
    -->
    <plugin filename="libshuttle_manager_system.so"
            name="scrobot_simulation::ShuttleManagerSystem">
      <robot_model>scrobot</robot_model>
      <update_rate>30.0</update_rate>
      <ground_truth_topic>/evaluation/shuttle_ground_truth_gz</ground_truth_topic>
      <collected_topic>/evaluation/shuttle_collected_gz</collected_topic>
      <collector_link>collector_link</collector_link>
      <pickup_half_length>0.030</pickup_half_length>
      <pickup_half_width>0.150</pickup_half_width>
      <shuttle_center_offset_z>0.045</shuttle_center_offset_z>
    </plugin>

    <!--
      Badminton venue lighting approximation.
      BWF guidance calls for even court lighting at a minimum 1000 lux for
      high-level sanctioned play and recommends side-positioned luminaires
      rather than fixtures directly above the playing area. Gazebo light power
      is not a calibrated lux meter, so these six symmetric side luminaires are
      tuned for even RGB-camera illumination and good white-shuttle contrast.
    -->
    <scene>
      <ambient>0.08 0.08 0.08 1</ambient>
      <background>0.025 0.030 0.035 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="spot" name="court_light_left_1">
      <pose>-4.5 4.6 7.0 0 0 0</pose>
      <diffuse>0.95 0.95 0.92 1</diffuse>
      <specular>0.20 0.20 0.20 1</specular>
      <direction>0 -0.55 -0.84</direction>
      <attenuation><range>18</range><constant>0.45</constant><linear>0.015</linear><quadratic>0.001</quadratic></attenuation>
      <spot><inner_angle>0.70</inner_angle><outer_angle>1.20</outer_angle><falloff>0.80</falloff></spot>
      <cast_shadows>true</cast_shadows>
    </light>
    <light type="spot" name="court_light_left_2">
      <pose>0 4.6 7.0 0 0 0</pose>
      <diffuse>0.95 0.95 0.92 1</diffuse>
      <specular>0.20 0.20 0.20 1</specular>
      <direction>0 -0.55 -0.84</direction>
      <attenuation><range>18</range><constant>0.45</constant><linear>0.015</linear><quadratic>0.001</quadratic></attenuation>
      <spot><inner_angle>0.70</inner_angle><outer_angle>1.20</outer_angle><falloff>0.80</falloff></spot>
      <cast_shadows>true</cast_shadows>
    </light>
    <light type="spot" name="court_light_left_3">
      <pose>4.5 4.6 7.0 0 0 0</pose>
      <diffuse>0.95 0.95 0.92 1</diffuse>
      <specular>0.20 0.20 0.20 1</specular>
      <direction>0 -0.55 -0.84</direction>
      <attenuation><range>18</range><constant>0.45</constant><linear>0.015</linear><quadratic>0.001</quadratic></attenuation>
      <spot><inner_angle>0.70</inner_angle><outer_angle>1.20</outer_angle><falloff>0.80</falloff></spot>
      <cast_shadows>true</cast_shadows>
    </light>
    <light type="spot" name="court_light_right_1">
      <pose>-4.5 -4.6 7.0 0 0 0</pose>
      <diffuse>0.95 0.95 0.92 1</diffuse>
      <specular>0.20 0.20 0.20 1</specular>
      <direction>0 0.55 -0.84</direction>
      <attenuation><range>18</range><constant>0.45</constant><linear>0.015</linear><quadratic>0.001</quadratic></attenuation>
      <spot><inner_angle>0.70</inner_angle><outer_angle>1.20</outer_angle><falloff>0.80</falloff></spot>
      <cast_shadows>true</cast_shadows>
    </light>
    <light type="spot" name="court_light_right_2">
      <pose>0 -4.6 7.0 0 0 0</pose>
      <diffuse>0.95 0.95 0.92 1</diffuse>
      <specular>0.20 0.20 0.20 1</specular>
      <direction>0 0.55 -0.84</direction>
      <attenuation><range>18</range><constant>0.45</constant><linear>0.015</linear><quadratic>0.001</quadratic></attenuation>
      <spot><inner_angle>0.70</inner_angle><outer_angle>1.20</outer_angle><falloff>0.80</falloff></spot>
      <cast_shadows>true</cast_shadows>
    </light>
    <light type="spot" name="court_light_right_3">
      <pose>4.5 -4.6 7.0 0 0 0</pose>
      <diffuse>0.95 0.95 0.92 1</diffuse>
      <specular>0.20 0.20 0.20 1</specular>
      <direction>0 0.55 -0.84</direction>
      <attenuation><range>18</range><constant>0.45</constant><linear>0.015</linear><quadratic>0.001</quadratic></attenuation>
      <spot><inner_angle>0.70</inner_angle><outer_angle>1.20</outer_angle><falloff>0.80</falloff></spot>
      <cast_shadows>true</cast_shadows>
    </light>

    <!--
      Venue floor + tournament-style green badminton mat.
      The 15.4 x 7.2 m mat matches the published size and green colour of the
      BWF-approved Yonex AC367 court mat. The exact manufacturer's RGB value is
      not published, so the Gazebo material is a visually representative matte
      tournament green rather than a claimed colorimetric match.
    -->
    <model name="court_floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="floor_collision">
          <geometry><box><size>20.0 12.0 0.02</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>

        <visual name="venue_floor_visual">
          <!-- Keep the dark venue surface 2 mm below the court-mat surface.
               This removes coplanar black/green z-fighting in Ogre2. -->
          <pose>0 0 -0.001 0 0 0</pose>
          <geometry><box><size>20.0 12.0 0.018</size></box></geometry>
          <material>
            <ambient>0.055 0.060 0.065 1</ambient>
            <diffuse>0.075 0.080 0.085 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>

        <visual name="badminton_mat_visual">
          <!-- Mat top surface is exactly z=0. Court lines start at z=0 and
               extend upward, so they render cleanly without z-fighting. -->
          <pose>0 0 0.009 0 0 0</pose>
          <geometry><box><size>15.4 7.2 0.002</size></box></geometry>
          <material>
            <ambient>0.045 0.265 0.145 1</ambient>
            <diffuse>0.055 0.345 0.185 1</diffuse>
            <specular>0.015 0.015 0.015 1</specular>
          </material>
        </visual>
      </link>
      <pose>0 0 -0.01 0 0 0</pose>
    </model>

    <!--
      Simulation safety boundary. These walls are outside the badminton mat
      and are not part of the regulation court geometry; they only prevent the
      robot from driving off the finite simulated venue floor.
      Interior clear area: approximately 19.8 x 11.8 m.
    -->
    <model name="simulation_safety_boundary">
      <static>true</static>
      <link name="boundary_link">

        <collision name="wall_x_positive_collision">
          <pose>9.95 0 0.20 0 0 0</pose>
          <geometry><box><size>0.10 12.0 0.40</size></box></geometry>
        </collision>
        <visual name="wall_x_positive_visual">
          <pose>9.95 0 0.20 0 0 0</pose>
          <geometry><box><size>0.10 12.0 0.40</size></box></geometry>
          <material>
            <ambient>0.10 0.10 0.11 1</ambient>
            <diffuse>0.14 0.14 0.15 1</diffuse>
          </material>
        </visual>

        <collision name="wall_x_negative_collision">
          <pose>-9.95 0 0.20 0 0 0</pose>
          <geometry><box><size>0.10 12.0 0.40</size></box></geometry>
        </collision>
        <visual name="wall_x_negative_visual">
          <pose>-9.95 0 0.20 0 0 0</pose>
          <geometry><box><size>0.10 12.0 0.40</size></box></geometry>
          <material>
            <ambient>0.10 0.10 0.11 1</ambient>
            <diffuse>0.14 0.14 0.15 1</diffuse>
          </material>
        </visual>

        <collision name="wall_y_positive_collision">
          <pose>0 5.95 0.20 0 0 0</pose>
          <geometry><box><size>19.8 0.10 0.40</size></box></geometry>
        </collision>
        <visual name="wall_y_positive_visual">
          <pose>0 5.95 0.20 0 0 0</pose>
          <geometry><box><size>19.8 0.10 0.40</size></box></geometry>
          <material>
            <ambient>0.10 0.10 0.11 1</ambient>
            <diffuse>0.14 0.14 0.15 1</diffuse>
          </material>
        </visual>

        <collision name="wall_y_negative_collision">
          <pose>0 -5.95 0.20 0 0 0</pose>
          <geometry><box><size>19.8 0.10 0.40</size></box></geometry>
        </collision>
        <visual name="wall_y_negative_visual">
          <pose>0 -5.95 0.20 0 0 0</pose>
          <geometry><box><size>19.8 0.10 0.40</size></box></geometry>
          <material>
            <ambient>0.10 0.10 0.11 1</ambient>
            <diffuse>0.14 0.14 0.15 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <model name="court_markings">

      <static>true</static>

      <link name="markings">

        <!-- ================================================= -->
        <!-- Doubles sidelines: y = +/- 3.05                   -->
        <!-- ================================================= -->

        <visual name="doubles_sideline_left">
          <pose>0 3.05 0.0005 0 0 0</pose>

          <geometry>
            <box>
              <size>13.44 0.04 0.001</size>
            </box>
          </geometry>

          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>


        <visual name="doubles_sideline_right">
          <pose>0 -3.05 0.0005 0 0 0</pose>

          <geometry>
            <box>
              <size>13.44 0.04 0.001</size>
            </box>
          </geometry>

          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>


        <!-- ================================================= -->
        <!-- Singles sidelines: y = +/- 2.59                   -->
        <!-- ================================================= -->

        <visual name="singles_sideline_left">
          <pose>0 2.59 0.0005 0 0 0</pose>

          <geometry>
            <box>
              <size>13.40 0.04 0.001</size>
            </box>
          </geometry>

          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>


        <visual name="singles_sideline_right">
          <pose>0 -2.59 0.0005 0 0 0</pose>

          <geometry>
            <box>
              <size>13.40 0.04 0.001</size>
            </box>
          </geometry>

          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>


        <!-- ================================================= -->
        <!-- Back boundaries: x = +/- 6.70                     -->
        <!-- ================================================= -->

        <visual name="baseline_positive">
          <pose>6.70 0 0.0005 0 0 0</pose>

          <geometry>
            <box>
              <size>0.04 6.14 0.001</size>
            </box>
          </geometry>

          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>


        <visual name="baseline_negative">
          <pose>-6.70 0 0.0005 0 0 0</pose>

          <geometry>
            <box>
              <size>0.04 6.14 0.001</size>
            </box>
          </geometry>

          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>


        <!-- ================================================= -->
        <!-- Short service lines: +/-1.98 from net             -->
        <!-- ================================================= -->

        <visual name="short_service_positive">
          <pose>1.98 0 0.0005 0 0 0</pose>

          <geometry>
            <box>
              <size>0.04 6.10 0.001</size>
            </box>
          </geometry>

          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>


        <visual name="short_service_negative">
          <pose>-1.98 0 0.0005 0 0 0</pose>

          <geometry>
            <box>
              <size>0.04 6.10 0.001</size>
            </box>
          </geometry>

          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>


        <!-- ================================================= -->
        <!-- Doubles long service lines                        -->
        <!-- 6.70 - 0.76 = 5.94                                -->
        <!-- ================================================= -->

        <visual name="long_service_positive">
          <pose>5.94 0 0.0005 0 0 0</pose>

          <geometry>
            <box>
              <size>0.04 6.10 0.001</size>
            </box>
          </geometry>

          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>


        <visual name="long_service_negative">
          <pose>-5.94 0 0.0005 0 0 0</pose>

          <geometry>
            <box>
              <size>0.04 6.10 0.001</size>
            </box>
          </geometry>

          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>


        <!-- ================================================= -->
        <!-- Centre service lines                              -->
        <!-- midpoint between 1.98 and 6.70 = 4.34             -->
        <!-- length = 6.70 - 1.98 = 4.72                       -->
        <!-- ================================================= -->

        <visual name="center_service_positive">
          <pose>4.34 0 0.0005 0 0 0</pose>

          <geometry>
            <box>
              <size>4.72 0.04 0.001</size>
            </box>
          </geometry>

          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>


        <visual name="center_service_negative">
          <pose>-4.34 0 0.0005 0 0 0</pose>

          <geometry>
            <box>
              <size>4.72 0.04 0.001</size>
            </box>
          </geometry>

          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>

      </link>

    </model>

    <model name="net_assembly">

      <static>true</static>

      <link name="net_link">


        <!-- ================================================= -->
        <!-- LEFT POST                                         -->
        <!-- ================================================= -->

        <collision name="left_post_collision">

          <pose>0 3.05 0.775 0 0 0</pose>

          <geometry>
            <cylinder>
              <radius>0.025</radius>
              <length>1.55</length>
            </cylinder>
          </geometry>

        </collision>


        <visual name="left_post_visual">

          <pose>0 3.05 0.775 0 0 0</pose>

          <geometry>
            <cylinder>
              <radius>0.025</radius>
              <length>1.55</length>
            </cylinder>
          </geometry>

          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>

        </visual>


        <!-- ================================================= -->
        <!-- RIGHT POST                                        -->
        <!-- ================================================= -->

        <collision name="right_post_collision">

          <pose>0 -3.05 0.775 0 0 0</pose>

          <geometry>
            <cylinder>
              <radius>0.025</radius>
              <length>1.55</length>
            </cylinder>
          </geometry>

        </collision>


        <visual name="right_post_visual">

          <pose>0 -3.05 0.775 0 0 0</pose>

          <geometry>
            <cylinder>
              <radius>0.025</radius>
              <length>1.55</length>
            </cylinder>
          </geometry>

          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>

        </visual>


        <!-- ================================================= -->
        <!-- NET: VISUAL ONLY                                  -->
        <!-- ================================================= -->

        <visual name="net_visual">

          <!-- Top = 1.55 m, depth = 0.76 m -->
          <pose>0 0 1.17 0 0 0</pose>

          <geometry>
            <box>
              <size>0.005 6.10 0.76</size>
            </box>
          </geometry>

          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
          </material>

          <transparency>0.65</transparency>

        </visual>


        <!-- White top tape -->

        <visual name="net_top_tape">

          <pose>0 0 1.5125 0 0 0</pose>

          <geometry>
            <box>
              <size>0.01 6.10 0.075</size>
            </box>
          </geometry>

          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>

        </visual>

      </link>

    </model>

    <include>

      <uri>
        model://court_apriltags
      </uri>

    </include>

  </world>

</sdf>