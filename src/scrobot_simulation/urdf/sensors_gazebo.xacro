<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="scrobot_gazebo_sensors" params="enable_magnetometer:=false">

    <!-- ====================================================== -->
    <!-- D435i combined IMU                                     -->
    <!-- ====================================================== -->

    <gazebo reference="camera_imu_optical_frame">
      <sensor name="d435i_imu" type="imu">
        <always_on>true</always_on>
        <update_rate>100.0</update_rate>
        <visualize>false</visualize>

        <topic>/camera/imu</topic>
        <gz_frame_id>camera_imu_optical_frame</gz_frame_id>

        <imu>
          <!--
            Match the real D435i behavior:
            accel + gyro are available, but orientation is not
            directly estimated by the camera.
          -->
          <orientation_enabled>false</orientation_enabled>
        </imu>
      </sensor>
    </gazebo>


    <!-- ====================================================== -->
    <!-- Separate 5883L magnetometer                            -->
    <!-- ====================================================== -->

    <xacro:if value="${enable_magnetometer}">
      <gazebo reference="mag_link">
        <sensor name="magnetometer_5883l" type="magnetometer">
          <always_on>true</always_on>
          <update_rate>50.0</update_rate>
          <visualize>false</visualize>
          <topic>/imu/mag</topic>
          <gz_frame_id>mag_link</gz_frame_id>
        </sensor>
      </gazebo>
    </xacro:if>


    <!-- ====================================================== -->
    <!-- D435i COLOR CAMERA                                     -->
    <!-- ====================================================== -->

    <gazebo reference="camera_color_frame">
      <sensor name="d435i_color" type="camera">
        <always_on>true</always_on>
        <update_rate>15.0</update_rate>
        <visualize>true</visualize>

        <topic>/camera/color</topic>
        <gz_frame_id>camera_color_optical_frame</gz_frame_id>

        <camera name="d435i_color_camera">
          <!--
            Match the factory calibration of the project's physical D435i
            at 1280x720.  fx=906.940246582031 px gives HFOV=70.418899 deg.
            Keep the simulated stream at 15 Hz for current system testing.
          -->
          <horizontal_fov>1.229041640167034</horizontal_fov>

          <camera_info_topic>/camera/color/camera_info</camera_info_topic>

          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>

          <clip>
            <near>0.05</near>
            <far>20.0</far>
          </clip>

          <optical_frame_id>camera_color_optical_frame</optical_frame_id>
        </camera>
      </sensor>
    </gazebo>


    <!-- ====================================================== -->
    <!-- D435i RAW DEPTH CAMERA                                 -->
    <!-- ====================================================== -->

    <gazebo reference="camera_depth_frame">
      <sensor name="d435i_depth" type="depth_camera">
        <always_on>true</always_on>
        <update_rate>15.0</update_rate>
        <visualize>true</visualize>

        <topic>/camera/depth</topic>
        <gz_frame_id>camera_depth_optical_frame</gz_frame_id>

        <camera name="d435i_depth_camera">
          <!--
            Match the factory calibration of the project's physical D435i
            depth stream at 848x480.  fx=420.289855957031 px gives
            HFOV=90.503557 deg.  Keep the simulated stream at 15 Hz.
          -->
          <horizontal_fov>1.5795850624055896</horizontal_fov>

          <camera_info_topic>/camera/depth/camera_info</camera_info_topic>

          <image>
            <width>848</width>
            <height>480</height>
            <format>R_FLOAT32</format>
          </image>

          <clip>
            <near>0.20</near>
            <far>10.0</far>
          </clip>

          <optical_frame_id>camera_depth_optical_frame</optical_frame_id>
        </camera>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>
