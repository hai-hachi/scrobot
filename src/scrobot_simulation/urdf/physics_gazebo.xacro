<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro
    name="scrobot_gazebo_physics"
    params="drive_contact_mu:=5.0 caster_contact_mu:=0.05">

    <!-- ============================================================ -->
    <!-- Narrow line-contact drive-wheel model tuned for stable traction -->
    <!-- ============================================================ -->
    <!--
      The visual / physical tire remains 30 mm wide in scrobot_description,
      while spawn_robot.launch.py overrides only the Gazebo collision width to
      1 mm. The narrow contact patch is intentional: the full-width collision
      produced excessive lateral skid for this differential-drive model.

      Both contact directions still use configurable friction coefficients and
      force-dependent slip remains disabled. These are simulation-stability
      values, not measured tire/material coefficients.

      fdir1 follows the wheel rolling direction (link +X).
    -->

    <gazebo reference="left_wheel_link">
      <mu1>${drive_contact_mu}</mu1>
      <mu2>${drive_contact_mu}</mu2>
      <fdir1>1 0 0</fdir1>
      <slip1>0.0</slip1>
      <slip2>0.0</slip2>
      <maxContacts>10</maxContacts>
    </gazebo>

    <gazebo reference="right_wheel_link">
      <mu1>${drive_contact_mu}</mu1>
      <mu2>${drive_contact_mu}</mu2>
      <fdir1>1 0 0</fdir1>
      <slip1>0.0</slip1>
      <slip2>0.0</slip2>
      <maxContacts>10</maxContacts>
    </gazebo>


    <!-- ============================================================ -->
    <!-- Passive casters                                             -->
    <!-- ============================================================ -->
    <!--
      Keep caster-ground friction low enough for passive swiveling, but
      not effectively frictionless. This reduces unrealistic caster
      skating while allowing the drive wheels to dominate traction.
    -->

    <gazebo reference="left_caster_wheel_link">
      <mu1>${caster_contact_mu}</mu1>
      <mu2>${caster_contact_mu}</mu2>
      <maxContacts>10</maxContacts>
    </gazebo>

    <gazebo reference="right_caster_wheel_link">
      <mu1>${caster_contact_mu}</mu1>
      <mu2>${caster_contact_mu}</mu2>
      <maxContacts>10</maxContacts>
    </gazebo>


    <!-- ============================================================ -->
    <!-- Base                                                        -->
    <!-- Normally should NOT contact the floor                       -->
    <!-- ============================================================ -->

    <gazebo reference="base_link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>

  </xacro:macro>

</robot>
