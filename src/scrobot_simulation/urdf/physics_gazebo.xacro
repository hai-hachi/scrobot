<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="scrobot_gazebo_physics">

    <!-- ============================================================ -->
    <!-- Physical-width drive-wheel contact tuned for stable traction -->
    <!-- ============================================================ -->
    <!--
      Normal simulation keeps the real 30 mm tire collision width.
      Gazebo previously showed excessive wheel skid with ordinary
      contact settings, so both contact directions use a deliberately
      elevated friction coefficient while force-dependent slip remains
      disabled. These are simulation-stability values, not measured
      tire/material coefficients.

      fdir1 follows the wheel rolling direction (link +X).
    -->

    <gazebo reference="left_wheel_link">
      <mu1>5.0</mu1>
      <mu2>5.0</mu2>
      <fdir1>1 0 0</fdir1>
      <slip1>0.0</slip1>
      <slip2>0.0</slip2>
      <maxContacts>10</maxContacts>
    </gazebo>

    <gazebo reference="right_wheel_link">
      <mu1>5.0</mu1>
      <mu2>5.0</mu2>
      <fdir1>1 0 0</fdir1>
      <slip1>0.0</slip1>
      <slip2>0.0</slip2>
      <maxContacts>10</maxContacts>
    </gazebo>


    <!-- ============================================================ -->
    <!-- Passive casters                                             -->
    <!-- ============================================================ -->
    <!--
      Keep caster-ground friction low enough for passive swiveling, but
      not effectively frictionless. This reduces unrealistic caster
      skating while allowing the drive wheels to dominate traction.
    -->

    <gazebo reference="left_caster_wheel_link">
      <mu1>0.05</mu1>
      <mu2>0.05</mu2>
      <maxContacts>10</maxContacts>
    </gazebo>

    <gazebo reference="right_caster_wheel_link">
      <mu1>0.05</mu1>
      <mu2>0.05</mu2>
      <maxContacts>10</maxContacts>
    </gazebo>


    <!-- ============================================================ -->
    <!-- Base                                                        -->
    <!-- Normally should NOT contact the floor                       -->
    <!-- ============================================================ -->

    <gazebo reference="base_link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>

  </xacro:macro>

</robot>
