<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="scrobot">

  <xacro:arg name="drive_contact_mu" default="5.0"/>
  <xacro:arg name="caster_contact_mu" default="0.05"/>

  <!-- Real robot geometry -->
  <xacro:include
    filename="$(find scrobot_description)/urdf/scrobot.urdf.xacro"/>

  <!-- Gazebo sensors -->
  <xacro:include
    filename="$(find scrobot_simulation)/urdf/sensors_gazebo.xacro"/>

  <!-- Gazebo physical properties -->
  <xacro:include
    filename="$(find scrobot_simulation)/urdf/physics_gazebo.xacro"/>

  <xacro:scrobot_gazebo_sensors enable_magnetometer="$(arg enable_magnetometer)"/>
  <xacro:scrobot_gazebo_physics
    drive_contact_mu="$(arg drive_contact_mu)"
    caster_contact_mu="$(arg caster_contact_mu)"/>

  <!-- Gazebo-only ground-truth odometry. Keep simulation/evaluation plugins
       out of scrobot_description so the real robot URDF stays hardware-only. -->
  <gazebo>
    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_publish_frequency>50.0</odom_publish_frequency>
      <odom_topic>/evaluation/scrobot/ground_truth_odom_gz</odom_topic>
      <tf_topic>/evaluation/scrobot/ground_truth_tf_gz</tf_topic>
      <dimensions>2</dimensions>
      <gaussian_noise>0.0</gaussian_noise>
    </plugin>
  </gazebo>

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="left_caster_swivel_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_caster_wheel_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_caster_swivel_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_caster_wheel_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin
      filename="libgz_ros2_control-system.so"
      name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find scrobot_control)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>
</robot>
