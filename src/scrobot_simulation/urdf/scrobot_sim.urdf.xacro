<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="scrobot">

  <xacro:arg name="enable_magnetometer" default="true"/>
  <xacro:arg name="enable_depth_camera" default="true"/>
  <xacro:arg name="imu_rate_hz" default="100.0"/>
  <xacro:arg name="magnetometer_rate_hz" default="100.0"/>
  <xacro:arg name="ground_truth_rate_hz" default="100.0"/>
  <xacro:arg name="color_width" default="1280"/>
  <xacro:arg name="color_height" default="720"/>
  <xacro:arg name="color_fps" default="15.0"/>
  <xacro:arg name="depth_width" default="848"/>
  <xacro:arg name="depth_height" default="480"/>
  <xacro:arg name="depth_fps" default="15.0"/>
  <xacro:arg name="drive_contact_mu" default="5.0"/>
  <xacro:arg name="caster_contact_mu" default="0.05"/>
  <xacro:arg name="drive_slip1" default="0.0"/>
  <xacro:arg name="drive_slip2" default="0.0"/>
  <xacro:arg
    name="controller_params"
    default="$(find scrobot_control)/config/controllers.yaml"/>

  <!-- Real robot geometry -->
  <xacro:include
    filename="$(find scrobot_description)/urdf/scrobot.urdf.xacro"/>

  <!-- Gazebo sensors -->
  <xacro:include
    filename="$(find scrobot_simulation)/urdf/sensors_gazebo.xacro"/>

  <!-- Gazebo physical properties -->
  <xacro:include
    filename="$(find scrobot_simulation)/urdf/physics_gazebo.xacro"/>

  <!-- Simulated magnetic sensor is aligned with base_link. Keep mag_link in
       TF even if SDFormat reduces fixed joints into their parent link. -->
  <xacro:if value="$(arg enable_magnetometer)">
    <link name="mag_link"/>
    <joint name="mag_mount_joint" type="fixed">
      <parent link="base_link"/>
      <child link="mag_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
  </xacro:if>

  <xacro:scrobot_gazebo_sensors
    enable_magnetometer="$(arg enable_magnetometer)"
    enable_depth_camera="$(arg enable_depth_camera)"
    imu_rate_hz="$(arg imu_rate_hz)"
    magnetometer_rate_hz="$(arg magnetometer_rate_hz)"
    color_width="$(arg color_width)"
    color_height="$(arg color_height)"
    color_fps="$(arg color_fps)"
    depth_width="$(arg depth_width)"
    depth_height="$(arg depth_height)"
    depth_fps="$(arg depth_fps)"/>
  <xacro:scrobot_gazebo_physics
    drive_contact_mu="$(arg drive_contact_mu)"
    caster_contact_mu="$(arg caster_contact_mu)"
    drive_slip1="$(arg drive_slip1)"
    drive_slip2="$(arg drive_slip2)"/>

  <!-- Gazebo-only ground-truth odometry. Keep simulation/evaluation plugins
       out of scrobot_description so the real robot URDF stays hardware-only. -->
  <gazebo>
    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_publish_frequency>$(arg ground_truth_rate_hz)</odom_publish_frequency>
      <odom_topic>/evaluation/scrobot/ground_truth_odom_gz</odom_topic>
      <tf_topic>/evaluation/scrobot/ground_truth_tf_gz</tf_topic>
      <dimensions>2</dimensions>
      <gaussian_noise>0.0</gaussian_noise>
    </plugin>
  </gazebo>

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="left_caster_swivel_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_caster_wheel_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_caster_swivel_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_caster_wheel_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin
      filename="libgz_ros2_control-system.so"
      name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controller_params)</parameters>
    </plugin>
  </gazebo>
</robot>
