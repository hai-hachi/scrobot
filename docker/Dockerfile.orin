FROM ros:jazzy-ros-base-noble

ARG USER_ID=1000
ARG GROUP_ID=1000
ARG USER_NAME=scrobot

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    curl \
    git \
    i2c-tools \
    less \
    libssl-dev \
    libudev-dev \
    libusb-1.0-0-dev \
    nano \
    net-tools \
    procps \
    python3-colcon-common-extensions \
    python3-pip \
    python3-rosdep \
    python3-smbus \
    python3-serial \
    python3-vcstool \
    pkg-config \
    ros-jazzy-ros2controlcli \
    sudo \
    udev \
    usbutils \
    vim-tiny \
    && rm -rf /var/lib/apt/lists/*

RUN rosdep init 2>/dev/null || true && rosdep update

# Jetson R36.5 stock UVC/HID support exposes only a partial D435i device.
# Build the same librealsense version as the Jazzy wrapper with the kernel-
# independent RSUSB backend. Keep this layer before COPY so normal source edits
# do not trigger another lengthy librealsense rebuild.
ARG LIBREALSENSE_VERSION=2.58.4
RUN git clone --depth 1 --branch "v${LIBREALSENSE_VERSION}" \
      https://github.com/realsenseai/librealsense.git /tmp/librealsense && \
    cmake -S /tmp/librealsense -B /tmp/librealsense/build \
      -DCMAKE_BUILD_TYPE=Release \
      -DFORCE_RSUSB_BACKEND=ON \
      -DBUILD_EXAMPLES=OFF \
      -DBUILD_GRAPHICAL_EXAMPLES=OFF \
      -DBUILD_PYTHON_BINDINGS=OFF \
      -DBUILD_WITH_CUDA=OFF && \
    cmake --build /tmp/librealsense/build --parallel 4 && \
    cmake --install /tmp/librealsense/build && \
    echo '/usr/local/lib' > /etc/ld.so.conf.d/librealsense-rsusb.conf && \
    ldconfig && \
    rm -rf /tmp/librealsense

# Resolve the dependencies needed by the real-robot stack. Keep Gazebo simulation
# out of the embedded image.
COPY . /tmp/scrobot_repo
RUN apt-get update && \
    rosdep install \
      --from-paths \
        /tmp/scrobot_repo/src/scrobot_interfaces \
        /tmp/scrobot_repo/src/scrobot_description \
        /tmp/scrobot_repo/src/scrobot_control \
        /tmp/scrobot_repo/src/scrobot_hardware \
        /tmp/scrobot_repo/src/scrobot_localization \
        /tmp/scrobot_repo/src/scrobot_perception \
        /tmp/scrobot_repo/src/scrobot_navigation \
        /tmp/scrobot_repo/src/scrobot_bringup \
        /tmp/scrobot_repo/src/scrobot_mission \
      --ignore-src \
      --rosdistro jazzy \
      -r -y && \
    rm -rf /var/lib/apt/lists/* /tmp/scrobot_repo

# Match the host UID/GID so bind-mounted colcon build/install/log files are
# never created as root. The upstream ROS image may already contain UID 1000
# (normally the Ubuntu user), so reuse that account instead of creating a
# duplicate UID.
RUN set -eux; \
    existing_user="$(getent passwd "${USER_ID}" | cut -d: -f1 || true)"; \
    if [ -n "${existing_user}" ] && [ "${existing_user}" != "${USER_NAME}" ]; then \
      usermod --login "${USER_NAME}" "${existing_user}"; \
      usermod --home "/home/${USER_NAME}" --move-home "${USER_NAME}"; \
    elif [ -z "${existing_user}" ]; then \
      if ! getent group "${GROUP_ID}" >/dev/null; then \
        groupadd --gid "${GROUP_ID}" "${USER_NAME}"; \
      fi; \
      useradd --uid "${USER_ID}" --gid "${GROUP_ID}" --create-home --shell /bin/bash "${USER_NAME}"; \
    fi; \
    usermod --shell /bin/bash "${USER_NAME}"; \
    mkdir -p "/home/${USER_NAME}"; \
    chown "${USER_ID}:${GROUP_ID}" "/home/${USER_NAME}"; \
    echo "${USER_NAME} ALL=(ALL) NOPASSWD:ALL" > "/etc/sudoers.d/${USER_NAME}"; \
    chmod 0440 "/etc/sudoers.d/${USER_NAME}"; \
    echo 'source /opt/ros/jazzy/setup.bash' >> "/home/${USER_NAME}/.bashrc"; \
    echo '[ -f /workspace/install/setup.bash ] && source /workspace/install/setup.bash' >> "/home/${USER_NAME}/.bashrc"

ENV HOME=/home/${USER_NAME}
ENV LD_LIBRARY_PATH=/usr/local/lib:/opt/ros/jazzy/lib
WORKDIR /workspace

USER ${USER_NAME}

CMD ["bash"]
